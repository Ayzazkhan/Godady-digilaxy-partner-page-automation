pipeline {
  agent any
  options {
    timestamps()
    disableConcurrentBuilds()
  }

  stages {

    stage('Checkout') {
      steps {
        cleanWs()
        git branch: 'main',
            url: 'https://github.com/Ayzazkhan/Godady-digilaxy-partner-page-automation.git',
            credentialsId: 'github-access'
      }
    }

    stage('Setup') {
      steps {
        script {
          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          echo "   DIGILAXY PARTNER CARD REMOVAL PIPELINE"
          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

          sh """
            pip install beautifulsoup4 --quiet --break-system-packages || \
            pip install beautifulsoup4 --quiet
          """
          echo "✅ Dependencies ready"

          def domains = sh(
            script: "python3 -c \"import json; data=json.load(open('data/domains.json')); [print(d) for d in data]\"",
            returnStdout: true
          ).trim()

          echo "📋 TARGET DOMAINS (domains.json):"
          domains.split("\n").each { d -> echo "   • ${d}" }

          def alldomains = sh(
            script: "python3 -c \"import json; data=json.load(open('data/alldomains.json')); [print(d) for d in data]\"",
            returnStdout: true
          ).trim()

          echo "🌐 SERVER DOMAINS (alldomains.json):"
          alldomains.split("\n").each { d -> echo "   • ${d}" }
          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        }
      }
    }

    stage('Remove Partner Cards') {
      steps {
        script {
          def ftpHost     = "63u.9b4.mytemp.website"
          def ftpUsername = "all@63u.9b4.mytemp.website"
          def credId      = "ftp-digilaxy"

          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          echo "🔌 FTP CONNECTION"
          echo "   Host       : ${ftpHost}"
          echo "   Username   : ${ftpUsername}"
          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

          withCredentials([
            usernamePassword(
              credentialsId: credId,
              usernameVariable: 'FTP_USER_CRED',
              passwordVariable: 'FTP_PASS'
            )
          ]) {
            def exitCode = sh(
              script: """
                export FTP_HOST='${ftpHost}'
                export FTP_USER='${ftpUsername}'
                export FTP_PASS=\$FTP_PASS
                python3 scripts/sftp_modify_inject.py
              """,
              returnStatus: true
            )

            if (exitCode != 0) {
              currentBuild.result = 'UNSTABLE'
              echo "⚠️  Script completed with failures — see report above"
            } else {
              echo "✅ Script completed successfully"
            }
          }
        }
      }
    }
  }

  post {
    success {
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo "🎉 PIPELINE RESULT : SUCCESS"
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    }
    unstable {
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo "⚠️  PIPELINE RESULT : UNSTABLE — check report above"
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    }
    failure {
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo "❌ PIPELINE RESULT : FAILED"
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    }
    always {
      echo "📋 Build #${env.BUILD_NUMBER} completed at ${new Date()}"
    }
  }
}
