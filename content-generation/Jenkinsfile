            steps {
                dir('content-generation') {
                    sh '''
                    echo "🔍 Running Quality Validation..."
                    . venv/bin/activate
                    python3 -c "
import json
from collections import Counter

print('🎯 QUALITY VALIDATION REPORT')
print('=' * 50)

try:
    with open('optimized_content.json', 'r') as f:
        data = json.load(f)
    
    if not data:
        print('❌ No data found')
        exit(1)
    
    total = len(data)
    quality = Counter(d['quality_score'] for d in data)
    links = Counter(d['links_count'] for d in data)
    
    print(f'✅ VALIDATION SUCCESSFUL')
    print(f'📊 Summary:')
    print(f'   • Total pieces: {total}')
    print(f'   • Avg words: {sum(d[\\\"word_count\\\"] for d in data)/total:.1f}')
    print(f'   • Total links: {sum(d[\\\"links_count\\\"] for d in data)}')
    
    print(f'\\n🎯 Quality Breakdown:')
    for q, count in quality.most_common():
        pct = (count/total)*100
        print(f'   • {q}: {count} ({pct:.1f}%)')
    
    print(f'\\n🔗 Link Distribution:')
    for l, count in links.most_common():
        pct = (count/total)*100
        print(f'   • {l} links: {count} ({pct:.1f}%)')
    
    # Check for optimal content
    optimal = [d for d in data if d['quality_score'] in ['very good', 'excellent'] and d['links_count'] >= 1]
    print(f'\\n🏆 Optimal Pieces: {len(optimal)}/{total} ({len(optimal)/total*100:.1f}%)')
    
    print(f'\\n📝 Top Samples:')
    excellent = [d for d in data if d['quality_score'] == 'excellent']
    samples = excellent[:2] if excellent else data[:2]
    
    for i, sample in enumerate(samples, 1):
        print(f'\\n{i}. [{sample[\\\"quality_score\\\"]}] {sample[\\\"keyword\\\"]}')
        print(f'   {sample[\\\"content\\\"]}')
        print(f'   📝 {sample[\\\"word_count\\\"]} words | 🔗 {sample[\\\"links_count\\\"]} links')
    
except Exception as e:
    print(f'❌ Validation error: {e}')
