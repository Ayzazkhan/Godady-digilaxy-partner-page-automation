        stage('Create Stable Python Scripts') {
            steps {
                dir('content-generation') {
                    // Keep the Advanced Google Analyzer (it works fine)
                    writeFile file: 'advanced_google_analyzer.py', text: '''import json
import requests
from bs4 import BeautifulSoup
import re
import time
from urllib.parse import quote_plus, urlparse
from collections import Counter
import random

print("=" * 80)
print("🚀 ADVANCED GOOGLE SEARCH ANALYSIS - COMPETITOR INTELLIGENCE")
print("=" * 80)

try:
    with open("content.json", "r") as f:
        config = json.load(f)
    domain = config.get("target_domain", "economicsassignmenthelp.co.uk")
    niche = config.get("niche", "economics assignment help")
    keywords = config.get("keywords", [
        "economics assignment help", "economics assignment writing help", 
        "buy economics assignment", "pay someone to write economics assignment",
        "economics research paper help", "economics paper", 
        "economics paper writer", "order economics assignment"
    ])
except Exception as e:
    domain = "economicsassignmenthelp.co.uk"
    niche = "economics assignment help"
    keywords = [
        "economics assignment help", "economics assignment writing help", 
        "buy economics assignment", "economics research paper help"
    ]

print(f"🎯 Target Domain: {domain}")
print(f"📊 Niche Focus: {niche}")
print(f"🔑 Primary Keywords: {len(keywords)}")

class AdvancedCompetitorAnalyzer:
    def __init__(self):
        self.session = requests.Session()
        self.session.headers.update({
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8",
            "Accept-Language": "en-US,en;q=0.5",
            "Accept-Encoding": "gzip, deflate",
            "Connection": "keep-alive",
        })
    
    def google_search_advanced(self, query, num_results=8):
        """Advanced Google search with multiple fallback methods"""
        try:
            url = f"https://www.google.com/search?q={quote_plus(query)}&num={num_results}"
            response = self.session.get(url, timeout=25)
            response.raise_for_status()
            
            soup = BeautifulSoup(response.content, "html.parser")
            competitor_urls = []
            
            # Multiple selectors for Google results
            selectors = [
                "div.g a",  # Main results
                "a[href*='/url?q=']",  # URL links
                ".rc a",  # Result containers
            ]
            
            for selector in selectors:
                links = soup.select(selector)
                for link in links:
                    href = link.get("href", "")
                    if "/url?q=" in href:
                        try:
                            clean_url = href.split("/url?q=")[1].split("&")[0]
                            if (clean_url.startswith("http") and 
                                domain not in clean_url and
                                "google.com" not in clean_url):
                                competitor_urls.append(clean_url)
                        except:
                            continue
            
            return list(set(competitor_urls))[:5]
            
        except Exception as e:
            print(f"⚠️ Search error for '{query}': {str(e)[:100]}...")
            return []
    
    def extract_high_quality_content(self, url):
        """Extract only high-quality, relevant content"""
        try:
            response = self.session.get(url, timeout=20)
            soup = BeautifulSoup(response.content, "html.parser")
            
            # Remove unwanted elements
            for element in soup(["script", "style", "nav", "footer", "header", "aside"]):
                element.decompose()
            
            quality_content = []
            
            # Extract meta information
            meta_data = {
                "title": "",
                "description": "",
                "h1": [],
                "content": []
            }
            
            # Title
            if soup.title:
                meta_data["title"] = soup.title.get_text().strip()
            
            # Meta description
            meta_desc = soup.find("meta", attrs={"name": "description"})
            if meta_desc and meta_desc.get("content"):
                meta_data["description"] = meta_desc.get("content").strip()
            
            # Headings
            for i in range(1, 4):
                headings = soup.find_all(f"h{i}")
                for heading in headings:
                    text = heading.get_text().strip()
                    if 10 <= len(text) <= 150:
                        meta_data["h1"].append(text)
            
            # Quality content paragraphs
            content_selectors = [
                "main p", ".content p", ".entry-content p", ".post-content p",
                "article p", ".text-block p", ".description p", ".article-content p"
            ]
            
            for selector in content_selectors:
                paragraphs = soup.select(selector)
                for p in paragraphs:
                    text = self.clean_content(p.get_text())
                    if 50 <= len(text) <= 500:  # Quality length range
                        meta_data["content"].append(text)
            
            # Fallback: all paragraphs but filtered
            if not meta_data["content"]:
                all_paragraphs = soup.find_all("p")
                for p in all_paragraphs:
                    text = self.clean_content(p.get_text())
                    if (50 <= len(text) <= 400 and 
                        not any(word in text.upper() for word in ["PRIVACY", "TERMS", "COOKIE", "COPYRIGHT"])):
                        meta_data["content"].append(text)
            
            return meta_data
            
        except Exception as e:
            print(f"⚠️ Content extraction failed for {url}: {str(e)[:100]}...")
            return {"title": "", "description": "", "h1": [], "content": []}
    
    def clean_content(self, text):
        """Advanced content cleaning"""
        # Remove extra whitespace
        text = re.sub(r'\\s+', ' ', text)
        # Remove common garbage patterns
        garbage_patterns = [
            r'\\b(home|about|services|contact|login|sign up|menu)\\b',
            r'\\d{10,}',  # Long numbers
            r'[#@][^\\s]+',  # Hashtags and mentions
        ]
        
        for pattern in garbage_patterns:
            text = re.sub(pattern, '', text, flags=re.IGNORECASE)
        
        return text.strip()
    
    def analyze_competitor_seo(self, content_data):
        """Advanced SEO analysis of competitor content"""
        all_text = " ".join([
            content_data["title"],
            content_data["description"],
            " ".join(content_data["h1"]),
            " ".join(content_data["content"])
        ])
        
        # Keyword analysis
        keywords = self.extract_seo_keywords(all_text)
        
        # Content structure analysis
        sentences = self.extract_quality_sentences(" ".join(content_data["content"]))
        
        return {
            "keywords": keywords,
            "sentences": sentences,
            "content_volume": len(all_text),
            "heading_structure": content_data["h1"]
        }
    
    def extract_seo_keywords(self, text, top_n=50):
        """Extract high-value SEO keywords"""
        try:
            # Clean text
            text = text.lower()
            
            # Remove stop words and extract meaningful phrases
            stop_words = {
                "the", "and", "for", "with", "this", "that", "are", "from", 
                "have", "has", "had", "was", "were", "will", "would", "could",
                "should", "about", "when", "where", "how", "why", "which", "their",
                "there", "what", "them", "then", "than", "its", "into", "more"
            }
            
            # Extract 2-4 word phrases
            words = re.findall(r'\\b[a-zA-Z]{3,}\\b', text)
            phrases = []
            
            for n in [2, 3, 4]:  # Bigram, trigram, four-gram
                for i in range(len(words) - n + 1):
                    phrase = " ".join(words[i:i+n])
                    # Filter: no stop words, meaningful length
                    phrase_words = phrase.split()
                    if (not any(sw in phrase_words for sw in stop_words) and
                        len(phrase) >= n * 3):
                        phrases.append(phrase)
            
            # Frequency analysis
            freq = Counter(phrases)
            sorted_phrases = sorted(freq.items(), key=lambda x: x[1], reverse=True)
            
            # Filter by relevance to niche
            niche_terms = ["economics", "assignment", "help", "writing", "research", "paper"]
            relevant_phrases = [
                phrase for phrase, count in sorted_phrases
                if any(term in phrase for term in niche_terms) and count >= 2
            ]
            
            return relevant_phrases[:top_n] if relevant_phrases else [
                "economics assignment help", "economics assignment writing", 
                "economics research paper", "buy economics assignment"
            ]
            
        except Exception as e:
            print(f"⚠️ Keyword extraction error: {e}")
            return ["economics assignment help", "economics assignment writing help"]
    
    def extract_quality_sentences(self, text, min_length=20, max_length=120):
        """Extract high-quality, complete sentences"""
        sentences = re.split(r'[.!?]+', text)
        quality_sentences = []
        
        for sentence in sentences:
            clean_sentence = self.clean_content(sentence)
            words = clean_sentence.split()
            
            # Quality criteria
            if (min_length <= len(clean_sentence) <= max_length and
                len(words) >= 6 and
                not any(word in clean_sentence.upper() for word in ["PRIVACY", "TERMS", "COOKIE"]) and
                clean_sentence[0].isupper()):
                quality_sentences.append(clean_sentence)
        
        return quality_sentences[:30]  # Return top 30 sentences
    
    def extract_anchor_texts(self, url):
        """Extract natural, diverse anchor texts"""
        try:
            response = self.session.get(url, timeout=15)
            soup = BeautifulSoup(response.content, "html.parser")
            
            anchors = []
            for link in soup.find_all("a", href=True):
                text = self.clean_content(link.get_text())
                href = link.get("href", "")
                
                # Quality filters for anchor texts
                if (8 <= len(text) <= 40 and
                    not text.isupper() and
                    not any(word in text.lower() for word in ["click", "here", "read more", "link"]) and
                    not text.isdigit() and
                    not href.startswith(("javascript:", "#", "mailto:"))):
                    anchors.append(text)
            
            return list(set(anchors))[:20]
            
        except Exception as e:
            print(f"⚠️ Anchor extraction error: {e}")
            return ["Learn More", "Get Started", "View Services", "Contact Us"]

# Initialize analyzer
print("\\n🔍 STEP 1: Advanced Competitor Research...")
analyzer = AdvancedCompetitorAnalyzer()

search_queries = [
    f"{niche}",
    f"best {niche}",
    f"professional {niche}",
    f"top {niche} services",
    f"expert {niche}",
    f"quality {niche}",
    f"affordable {niche}"
]

all_competitors = []
for query in search_queries:
    print(f"  Searching: '{query}'")
    urls = analyzer.google_search_advanced(query)
    all_competitors.extend(urls)
    time.sleep(2)  # Respectful crawling

# Remove duplicates and limit
competitor_urls = list(set(all_competitors))[:8]
print(f"✅ Found {len(competitor_urls)} competitor websites")

print("\\n📊 STEP 2: Deep Content Analysis...")
all_seo_data = {
    "keywords": [],
    "sentences": [],
    "anchor_texts": [],
    "content_analysis": []
}

for i, url in enumerate(competitor_urls, 1):
    domain_name = urlparse(url).netloc
    print(f"  [{i}/{len(competitor_urls)}] Analyzing: {domain_name}")
    
    # Extract content
    content_data = analyzer.extract_high_quality_content(url)
    seo_analysis = analyzer.analyze_competitor_seo(content_data)
    anchors = analyzer.extract_anchor_texts(url)
    
    # Aggregate data
    all_seo_data["keywords"].extend(seo_analysis["keywords"])
