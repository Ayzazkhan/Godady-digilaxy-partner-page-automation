import json
import os
import random
import time
import re
import requests
from bs4 import BeautifulSoup
from urllib.parse import urljoin, urlparse
from datetime import datetime
from fake_useragent import UserAgent

print("=" * 70)
print("🚀 SMART CONTENT GENERATOR - WEBSITE ANALYSIS EDITION")
print("=" * 70)

# Load configuration
try:
    with open("content.json", "r") as f:
        config = json.load(f)
    print("✅ content.json loaded successfully")
except Exception as e:
    print(f"❌ ERROR reading content.json: {e}")
    exit(1)

domain = config.get("target_domain", "hesiexamtaker.com")
keywords = config.get("keywords", [])
base_content = config.get("base_content", "")

print(f"📊 CONFIGURATION:")
print(f"  - Domain: {domain}")
print(f"  - Keywords: {len(keywords)}")

# Extract links from base content
links = re.findall(r"<a href='https://[^']+'[^>]*>[^<]+</a>", base_content)
print(f"🔗 Found {len(links)} links in base content")

class WebsiteAnalyzer:
    def __init__(self, domain):
        self.domain = domain
        self.base_url = f"https://{domain}"
        self.ua = UserAgent()
        self.analyzed_content = ""
        self.content_style = ""
        self.common_phrases = []
        
    def fetch_website_content(self):
        """Fetch and analyze website content"""
        try:
            headers = {
                'User-Agent': self.ua.random,
                'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8',
                'Accept-Language': 'en-US,en;q=0.5',
                'Accept-Encoding': 'gzip, deflate',
                'Connection': 'keep-alive',
                'Upgrade-Insecure-Requests': '1',
            }
            
            print(f"🌐 Fetching website: {self.base_url}")
            response = requests.get(self.base_url, headers=headers, timeout=30)
            response.raise_for_status()
            
            soup = BeautifulSoup(response.content, 'html.parser')
            
            # Extract meaningful content
            content_elements = []
            
            # Get page title
            title = soup.find('title')
            if title:
                content_elements.append(title.get_text().strip())
            
            # Get meta description
            meta_desc = soup.find('meta', attrs={'name': 'description'})
            if meta_desc:
                content_elements.append(meta_desc.get('content', '').strip())
            
            # Get main content from common tags
            content_tags = ['h1', 'h2', 'h3', 'p', 'li', 'div']
            for tag in content_tags:
                elements = soup.find_all(tag)
                for element in elements:
                    text = element.get_text().strip()
                    if len(text) > 20 and len(text) < 500:  # Reasonable length
                        content_elements.append(text)
            
            self.analyzed_content = " ".join(content_elements)
            
            # Analyze content style
            self._analyze_content_style()
            
            print(f"✅ Website analyzed: {len(self.analyzed_content)} characters extracted")
            print(f"📝 Content style: {self.content_style}")
            print(f"🔤 Common phrases: {len(self.common_phrases)} found")
            
            return True
            
        except Exception as e:
            print(f"❌ Website analysis failed: {e}")
            return False
    
    def _analyze_content_style(self):
        """Analyze the writing style of the website"""
        if not self.analyzed_content:
            self.content_style = "professional"
            return
        
        content_lower = self.analyzed_content.lower()
        
        # Detect style based on keywords and patterns
        style_indicators = {
            'formal': ['comprehensive', 'professional', 'expert', 'quality', 'premium'],
            'educational': ['learn', 'study', 'guide', 'tutorial', 'education', 'knowledge'],
            'conversational': ['you', 'your', 'we', 'our', 'let\'s', 'discover'],
            'seo_optimized': ['best', 'top', 'guide', 'review', 'how to', 'tips'],
            'technical': ['system', 'process', 'methodology', 'framework', 'analysis']
        }
        
        detected_styles = []
        for style, indicators in style_indicators.items():
            matches = sum(1 for indicator in indicators if indicator in content_lower)
            if matches > 2:
                detected_styles.append(style)
        
        self.content_style = " + ".join(detected_styles) if detected_styles else "professional"
        
        # Extract common phrases (2-4 word sequences)
        words = re.findall(r'\\b\\w+\\b', self.analyzed_content.lower())
        phrases = {}
        for i in range(len(words) - 2):
            phrase = " ".join(words[i:i+3])
            if len(phrase) > 10:
                phrases[phrase] = phrases.get(phrase, 0) + 1
        
        # Get most common phrases
        self.common_phrases = [phrase for phrase, count in sorted(phrases.items(), key=lambda x: x[1], reverse=True)[:10]]

class SmartContentGenerator:
    def __init__(self, website_analyzer, links, keywords):
        self.analyzer = website_analyzer
        self.links = links
        self.keywords = keywords
        self.generated_hashes = set()
        
    def _get_website_based_templates(self):
        """Generate templates based on website analysis"""
        base_templates = [
            # Problem-Solution format
            "Struggling with {keyword}? {website_phrase} {link1} Our approach {similar_phrase} ensures {benefit}. {link2}",
            
            # Benefit-focused format  
            "Achieve {benefit} with our {keyword} solutions. {website_phrase} {link1} {similar_phrase} for optimal results. {link2}",
            
            # Educational format
            "Learn effective {keyword} strategies that deliver {benefit}. {website_phrase} {link1} {similar_phrase} {link2}",
            
            # Results-oriented format
            "Transform your {keyword} outcomes with proven methods. {website_phrase} {link1} Experience {benefit} through {similar_phrase}. {link2}",
            
            # Professional format
            "Professional {keyword} support for exceptional results. {website_phrase} {link1} {similar_phrase} ensures {benefit}. {link2}"
        ]
        
        return base_templates
    
    def _get_website_phrases(self):
        """Get phrases inspired by website content"""
        if self.analyzer.common_phrases:
            return random.sample(self.analyzer.common_phrases, min(3, len(self.analyzer.common_phrases)))
        else:
            return ["comprehensive approach", "proven methodology", "expert guidance"]
    
    def _get_benefits(self):
        """Get benefit phrases based on website style"""
        benefits = [
            "better results", "improved performance", "enhanced outcomes", 
            "greater success", "optimal performance", "superior outcomes",
            "exceptional results", "outstanding performance", "maximum effectiveness"
        ]
        return benefits
    
    def _get_similar_phrases(self):
        """Generate phrases similar to website style"""
        similar_phrases = [
            "following industry best practices", "utilizing proven techniques",
            "implementing effective strategies", "applying expert methodologies",
            "leveraging comprehensive approaches", "employing professional systems"
        ]
        return similar_phrases
    
    def generate_content(self, keyword):
        """Generate content inspired by website analysis"""
        attempts = 0
        while attempts < 5:
            # Choose template
            template = random.choice(self._get_website_based_templates())
            
            # Get variations
            website_phrase = random.choice(self._get_website_phrases())
            benefit = random.choice(self._get_benefits())
            similar_phrase = random.choice(self._get_similar_phrases())
            
            # Generate content
            content = template.format(
                keyword=keyword,
                website_phrase=website_phrase,
                similar_phrase=similar_phrase,
                benefit=benefit,
                link1=self.links[0],
                link2=self.links[1]
            )
            
            # Clean and format
            content = re.sub(r'\\s+', ' ', content).strip()
            content = content[0].upper() + content[1:]  # Capitalize first letter
            
            # Ensure proper length (30-50 words)
            words = content.split()
            if 30 <= len(words) <= 50:
                content_hash = hash(content.lower().strip()) % 1000000
                if content_hash not in self.generated_hashes:
                    self.generated_hashes.add(content_hash)
                    return content
            
            attempts += 1
        
        # Fallback template
        return f"Get professional {keyword} support with comprehensive resources. {self.links[0]} Our expert approach ensures optimal outcomes and successful results. {self.links[1]}"

# MAIN EXECUTION
print("\\n🔍 ANALYZING TARGET WEBSITE...")
analyzer = WebsiteAnalyzer(domain)

if analyzer.fetch_website_content():
    print("✅ Website analysis successful!")
else:
    print("⚠️ Using fallback analysis method")
    # Create basic analyzer with default values
    analyzer.analyzed_content = "professional nursing exam preparation guidance"
    analyzer.content_style = "professional + educational"
    analyzer.common_phrases = ["comprehensive preparation", "expert guidance", "proven methods"]

print(f"\\n🎯 GENERATING WEBSITE-INSPIRED CONTENT...")
generator = SmartContentGenerator(analyzer, links, keywords)

TOTAL_CONTENTS = 175
generated_data = []

for i in range(TOTAL_CONTENTS):
    try:
        keyword = random.choice(keywords)
        print(f"📝 {i+1}/{TOTAL_CONTENTS} - {keyword}")
        
        content = generator.generate_content(keyword)
        
        # Ensure links are included
        links_count = sum(1 for link in links if link in content)
        
        generated_data.append({
            "id": i + 1,
            "keyword": keyword,
            "content": content,
            "word_count": len(content.split()),
            "links_count": links_count,
            "style": analyzer.content_style,
            "timestamp": datetime.now().isoformat()
        })
        
        print(f"   ✅ Generated - Words: {len(content.split())}, Links: {links_count}")
        
        # Progress indicator
        if (i + 1) % 25 == 0:
            print(f"⏳ Progress: {i+1}/{TOTAL_CONTENTS} ({((i+1)/TOTAL_CONTENTS)*100:.1f}%)")
            time.sleep(0.5)
            
    except Exception as e:
        print(f"❌ Error in item {i+1}: {str(e)}")
        continue

# SAVE RESULTS
print("\\n💾 SAVING SMART CONTENT...")
try:
    output_file = "smart_website_content.json"
    with open(output_file, "w", encoding="utf-8") as f:
        json.dump(generated_data, f, indent=2, ensure_ascii=False)
    
    print(f"✅ Results saved to {output_file}")
    
except Exception as e:
    print(f"❌ Error saving results: {e}")
    exit(1)

# FINAL STATISTICS
print("\\n" + "=" * 70)
print("📊 SMART GENERATION COMPLETED")
print("=" * 70)
print(f"🎯 Target: {TOTAL_CONTENTS} content pieces")
print(f"✅ Generated: {len(generated_data)} ({len(generated_data)/TOTAL_CONTENTS*100:.1f}%)")
print(f"🔗 Total Links: {sum(item['links_count'] for item in generated_data)}")
print(f"📝 Total Words: {sum(item['word_count'] for item in generated_data)}")
print(f"🎨 Content Style: {analyzer.content_style}")
print(f"🔤 Unique Phrases: {len(generator.generated_hashes)}")

print("\\n🚀 WEBSITE-INSPIRED CONTENT GENERATION COMPLETED!")
EOF

                    # Run the smart content generator
                    python3 smart_content_generator.py
                    '''
                }
            }
        }

        stage('Verify & Push Results') {
            steps {
                dir('content-generation') {
