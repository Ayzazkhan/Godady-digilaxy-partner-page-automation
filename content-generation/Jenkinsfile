                    sh '''
                    echo "🚀 Generating SEO Expert Level Content..."
                    . venv/bin/activate
                    
                    python3 - << 'EOF'
import json
import random
import re

print("=" * 70)
print("🚀 SEO EXPERT CONTENT GENERATION")
print("=" * 70)

# Load Google analysis
with open("google_analysis.json", "r") as f:
    analysis = json.load(f)

# Load config for target domain
with open("content.json", "r") as f:
    config = json.load(f)
    target_domain = config.get("target_domain", "hesiexamtaker.com")

keywords = analysis['keywords']
anchor_texts = analysis['anchor_texts']
sample_sentences = analysis['sample_sentences']
writing_patterns = analysis['writing_patterns']

print(f"📊 Loaded data:")
print(f"   - Keywords: {len(keywords)}")
print(f"   - Anchor texts: {len(anchor_texts)}")
print(f"   - Sample sentences: {len(sample_sentences)}")

class SEOExpertContentGenerator:
    def __init__(self):
        self.keywords = keywords
        self.anchors = anchor_texts
        self.sentences = sample_sentences
        self.domain = target_domain
        self.starters = writing_patterns['common_starters']
    
    def create_dynamic_template(self):
        """Har baar naya template banao"""
        structures = [
            "{opener} {keyword_phrase}. {support1} <a href='https://{domain}/{slug}'>{anchor1}</a> {support2} <a href='https://{domain}/{slug2}'>{anchor2}</a>",
            "{keyword_phrase} {benefit}. {opener} <a href='https://{domain}/{slug}'>{anchor1}</a> {detail} <a href='https://{domain}/{slug2}'>{anchor2}</a>",
            "{question} {keyword_phrase}? {answer} <a href='https://{domain}/{slug}'>{anchor1}</a> {closer} <a href='https://{domain}/{slug2}'>{anchor2}</a>"
        ]
        return random.choice(structures)
    
    def generate_opener(self):
        """Natural opener banao"""
        openers = [
            f"{random.choice(self.starters)} professional",
            "Discover expert",
            "Access comprehensive",
            "Get specialized",
            "Learn proven strategies for"
        ]
        return random.choice(openers)
    
    def generate_question(self):
        """Natural question banao"""
        questions = [
            "Looking for",
            "Need help with",
            "Struggling with",
            "Want to excel in"
        ]
        return random.choice(questions)
    
    def generate_support(self):
        """Supporting sentence"""
        supports = [
            "Our expert team provides comprehensive solutions",
            "Professional guidance ensures better results",
            "Specialized support helps you achieve success",
            "Proven strategies deliver optimal outcomes"
        ]
        return random.choice(supports)
    
    def generate_slug(self, keyword):
        """URL slug banao keyword se"""
        slug = keyword.lower().replace(' ', '-')
        slug = re.sub(r'[^a-z0-9-]', '', slug)
        return slug[:30]
    
    def generate_content(self):
        """Ek complete SEO content piece banao"""
        # Select random keyword
        keyword = random.choice(self.keywords)
        
        # Select random anchors
        anchor1 = random.choice(self.anchors) if self.anchors else "Learn more"
        anchor2 = random.choice([a for a in self.anchors if a != anchor1]) if len(self.anchors) > 1 else "Get started"
        
        # Create slugs
        slug1 = self.generate_slug(keyword)
        slug2 = self.generate_slug(random.choice(self.keywords))
        
        # Get template
        template = self.create_dynamic_template()
        
        # Fill template
        content = template.format(
            opener=self.generate_opener(),
            question=self.generate_question(),
            keyword_phrase=keyword,
            benefit="for better results",
            answer="We provide expert solutions",
            support1=self.generate_support(),
            support2="ensuring your success",
            detail="with proven methodologies",
            closer="Start your journey today",
            domain=self.domain,
            slug=slug1,
            slug2=slug2,
            anchor1=anchor1,
            anchor2=anchor2
        )
        
        # Ensure proper word count (30-45 words)
        words = content.split()
        if len(words) > 50:
            content = ' '.join(words[:45]) + '.'
        elif len(words) < 30:
            content += f" Contact us for personalized {keyword} assistance."
        
        return content, keyword, anchor1, anchor2

# Generate 175 pieces
print("\n🎯 GENERATING 175 SEO EXPERT CONTENT PIECES...")

generator = SEOExpertContentGenerator()
generated_data = []

for i in range(175):
    content, keyword, anchor1, anchor2 = generator.generate_content()
    
    generated_data.append({
        "id": i + 1,
        "keyword": keyword,
        "content": content,
        "word_count": len(content.split()),
        "links_count": content.count('<a href'),
        "anchor_texts": [anchor1, anchor2],
        "quality": "seo_expert_level"
    })
    
    if (i + 1) % 25 == 0:
        print(f"✅ Generated {i + 1}/175")

# Save
with open("seo_expert_content.json", "w") as f:
    json.dump(generated_data, f, indent=2)

print("\n" + "=" * 70)
print("✅ SEO EXPERT CONTENT GENERATION COMPLETE!")
print("=" * 70)
print(f"📊 Statistics:")
print(f"   - Total pieces: {len(generated_data)}")
print(f"   - Avg words: {sum(item['word_count'] for item in generated_data) / len(generated_data):.1f}")
print(f"   - Total links: {sum(item['links_count'] for item in generated_data)}")
print(f"   - Unique keywords: {len(set(item['keyword'] for item in generated_data))}")

print(f"\n📋 SAMPLE CONTENT:")
for i in range(3):
    sample = generated_data[i]
    print(f"\n--- Sample {i+1} ---")
    print(f"Keyword: {sample['keyword']}")
    print(f"Content: {sample['content']}")
    print(f"Words: {sample['word_count']} | Links: {sample['links_count']}")
    print(f"Anchors: {sample['anchor_texts']}")

EOF
                    '''
                }
            }
        }

        stage('Quality Verification') {
