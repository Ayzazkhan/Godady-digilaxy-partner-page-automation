pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Ayzazkhan/Godady-digilaxy-partner-page-automation.git',
                    credentialsId: 'github-credentials'
            }
        }

        stage('Setup Environment') {
            steps {
                dir('content-generation') {
                    sh '''
                    echo "🐍 Setting up Python environment..."
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install requests beautifulsoup4 urllib3
                    echo "✅ Python packages installed"
                    '''
                }
            }
        }

        stage('Website Analysis') {
            steps {
                dir('content-generation') {
                    sh '''
                    echo "🔍 Analyzing Target Website..."
                    . venv/bin/activate
                    
                    # WEBSITE ANALYZER - Complete analysis in one script
                    python3 - << 'EOF'
import json
import requests
from bs4 import BeautifulSoup
import re
import random

print("=" * 60)
print("🚀 WEBSITE ANALYSIS - EXTRACTING BRAND DATA")
print("=" * 60)

# Load config
with open("content.json", "r") as f:
    config = json.load(f)

domain = config.get("target_domain", "hesiexamtaker.com")
print(f"🌐 Analyzing: {domain}")

try:
    headers = {'User-Agent': 'Mozilla/5.0'}
    response = requests.get(f"https://{domain}", headers=headers, timeout=30)
    soup = BeautifulSoup(response.content, 'html.parser')
    
    # Extract all content
    all_text = []
    
    # Meta data
    title = soup.find('title')
    if title:
        all_text.append(title.get_text().strip())
    
    meta_desc = soup.find('meta', attrs={'name': 'description'})
    if meta_desc:
        all_text.append(meta_desc.get('content', ''))
    
    # Headers and content
    for tag in ['h1', 'h2', 'h3', 'p', 'li']:
        elements = soup.find_all(tag)
        for element in elements:
            text = element.get_text().strip()
            if len(text) > 10:
                all_text.append(text)
    
    full_content = " ".join(all_text)
    print(f"📊 Extracted {len(full_content)} characters")
    
    # CREATE ANALYSIS ARRAYS
    analysis_data = {
        # Tone Analysis
        'tones': [],
        'brand_values': [],
        'services': [],
        'writing_styles': [],
        'common_phrases': [],
        'target_audience': [],
        'content_patterns': []
    }
    
    content_lower = full_content.lower()
    
    # Extract TONES
    if any(word in content_lower for word in ['professional', 'expert', 'certified']):
        analysis_data['tones'].append('professional')
    if any(word in content_lower for word in ['comprehensive', 'complete']):
        analysis_data['tones'].append('comprehensive')
    if any(word in content_lower for word in ['support', 'help', 'friendly']):
        analysis_data['tones'].append('supportive')
    
    # Extract BRAND VALUES
    if any(word in content_lower for word in ['quality', 'excellence']):
        analysis_data['brand_values'].append('quality')
    if any(word in content_lower for word in ['success', 'achievement']):
        analysis_data['brand_values'].append('success')
    
    # Extract SERVICES
    if any(word in content_lower for word in ['hesi', 'exam']):
        analysis_data['services'].append('hesi_preparation')
    if any(word in content_lower for word in ['nursing', 'nurse']):
        analysis_data['services'].append('nursing_exams')
    if any(word in content_lower for word in ['study', 'material']):
        analysis_data['services'].append('study_materials')
    
    # Extract COMMON PHRASES
    words = re.findall(r'\\b\\w+\\b', content_lower)
    phrases = {}
    for i in range(len(words) - 2):
        phrase = " ".join(words[i:i+3])
        if len(phrase) > 8:
            phrases[phrase] = phrases.get(phrase, 0) + 1
    
    analysis_data['common_phrases'] = [phrase for phrase, count in sorted(phrases.items(), key=lambda x: x[1], reverse=True)[:10]]
    
    # Set default values if empty
    if not analysis_data['tones']:
        analysis_data['tones'] = ['professional', 'supportive']
    if not analysis_data['brand_values']:
        analysis_data['brand_values'] = ['quality', 'success']
    if not analysis_data['services']:
        analysis_data['services'] = ['hesi_preparation', 'nursing_exams']
    
    analysis_data['writing_styles'] = ['professional', 'clear']
    analysis_data['target_audience'] = ['nursing_students', 'exam_takers']
    analysis_data['content_patterns'] = ['problem_solution', 'benefit_focused']
    
    # Save analysis
    with open("website_analysis.json", "w") as f:
        json.dump(analysis_data, f, indent=2)
    
    print("✅ ANALYSIS COMPLETE!")
    print(f"   - Tones: {analysis_data['tones']}")
    print(f"   - Services: {analysis_data['services']}")
    print(f"   - Common Phrases: {len(analysis_data['common_phrases'])}")
    
except Exception as e:
    print(f"❌ Analysis failed: {e}")
    # Create fallback data
    fallback_data = {
        'tones': ['professional', 'supportive'],
        'brand_values': ['quality', 'success'],
        'services': ['hesi_preparation', 'nursing_exams'],
        'writing_styles': ['professional', 'clear'],
        'common_phrases': ['comprehensive exam preparation', 'expert nursing guidance'],
        'target_audience': ['nursing_students', 'exam_takers'],
        'content_patterns': ['problem_solution', 'benefit_focused']
    }
    with open("website_analysis.json", "w") as f:
        json.dump(fallback_data, f, indent=2)
    print("⚠️ Using fallback analysis data")

print("💾 Analysis saved to website_analysis.json")
EOF
                    '''
                }
            }
        }

        stage('Generate Content') {
            steps {
                dir('content-generation') {
                    sh '''
                    echo "🚀 Generating Brand-Style Content..."
                    . venv/bin/activate
                    
                    # CONTENT GENERATOR - Complete generation in one script
                    python3 - << 'EOF'
import json
import random
import re

print("=" * 60)
print("🚀 CONTENT GENERATION - BRAND STYLE")
print("=" * 60)

# Load analysis data
with open("website_analysis.json", "r") as f:
    analysis = json.load(f)

# Load content config
with open("content.json", "r") as f:
    config = json.load(f)
    keywords = config.get("keywords", [])
    base_content = config.get("base_content", "")
    links = re.findall(r"<a href='https://[^']+'[^>]*>[^<]+</a>", base_content)

print(f"📊 Starting generation with:")
print(f"   - Keywords: {len(keywords)}")
print(f"   - Links: {len(links)}")
print(f"   - Brand Tone: {analysis['tones']}")

# CONTENT TEMPLATES based on analysis
TEMPLATES = [
    # Problem-Solution templates
    "Struggling with {keyword}? {brand_phrase} provides expert solutions. {link1} Get comprehensive {service} support for nursing success. {link2}",
    "Finding {keyword} challenging? {brand_phrase} offers professional guidance. {link1} Access specialized {service} resources and achieve better results. {link2}",
    
    # Benefit-Focused templates
    "Achieve exam success with our {keyword} solutions. {brand_phrase} {link1} Professional {service} support ensures optimal performance. {link2}",
    "Excel in {keyword} for better test scores. {brand_phrase} {link1} Comprehensive {service} resources available. {link2}",
    
    # Action-Oriented templates
    "Get expert {keyword} support with {brand_phrase}. {link1} Professional {service} guidance for nursing students. {link2}",
    "Learn proven {keyword} strategies from {brand_phrase}. {link1} Specialized {service} assistance available. {link2}"
]

# BENEFITS for nursing students
BENEFITS = [
    "better exam scores", "improved test performance", "enhanced preparation",
    "increased confidence", "stronger knowledge", "academic success"
]

def generate_single_content(keyword):
    """Generate one content piece (30-40 words)"""
    template = random.choice(TEMPLATES)
    brand_phrase = random.choice(analysis['common_phrases'])
    service = random.choice(analysis['services'])
    benefit = random.choice(BENEFITS)
    
    content = template.format(
        keyword=keyword,
        brand_phrase=brand_phrase,
        service=service,
        benefit=benefit,
        link1=links[0] if links else "",
        link2=links[1] if len(links) > 1 else ""
    )
    
    # Ensure proper length
    words = content.split()
    if len(words) > 40:
        content = " ".join(words[:40])
    elif len(words) < 30:
        # Add more content to reach 30 words
        extra_phrases = [
            "Start your success journey today.",
            "Achieve your nursing career goals.",
            "Get the professional support you need."
        ]
        content += " " + random.choice(extra_phrases)
    
    return content.strip()

# GENERATE 175 CONTENT PIECES
print("\\n🎯 GENERATING 175 CONTENT PIECES...")
generated_data = []

for i in range(175):
    keyword = random.choice(keywords)
    content = generate_single_content(keyword)
    
    generated_data.append({
        "id": i + 1,
        "keyword": keyword,
        "content": content,
        "word_count": len(content.split()),
        "links_count": 2,
        "tone": random.choice(analysis['tones'])
    })
    
    if (i + 1) % 25 == 0:
        print(f"✅ Generated {i + 1}/175")

# SAVE RESULTS
with open("final_content.json", "w") as f:
    json.dump(generated_data, f, indent=2)

print("\\n🎉 GENERATION COMPLETE!")
print(f"📊 Statistics:")
print(f"   - Total content: {len(generated_data)}")
print(f"   - Total words: {sum(item['word_count'] for item in generated_data)}")
print(f"   - Total links: {sum(item['links_count'] for item in generated_data)}")
print(f"   - Avg words per content: {sum(item['word_count'] for item in generated_data)/len(generated_data):.1f}")

print("\\n📋 SAMPLE CONTENT:")
print(generated_data[0]['content'])
EOF
                    '''
                }
            }
        }

        stage('Verify Results') {
            steps {
                dir('content-generation') {
                    sh '''
                    echo "🔍 Verifying Generated Content..."
                    . venv/bin/activate
                    
                    python3 -c "
import json
data = json.load(open('final_content.json'))
print('✅ VERIFICATION REPORT:')
print(f'   - Total pieces: {len(data)}')
print(f'   - Properly linked: {sum(1 for item in data if item[\\\"links_count\\\"] >= 2)}')
print(f'   - Avg word count: {sum(item[\\\"word_count\\\"] for item in data)/len(data):.1f}')
print(f'   - Unique keywords: {len(set(item[\\\"keyword\\\"] for item in data))}')
print('\\\\n🎯 FIRST 3 SAMPLES:')
for i, item in enumerate(data[:3]):
    print(f'   {i+1}. {item[\\\"keyword\\\"]} - {item[\\\"word_count\\\"]} words')
    print(f'      {item[\\\"content\\\"][:70]}...')
"
                    '''
                }
            }
        }

        stage('Push to GitHub') {
            steps {
                dir('content-generation') {
                    sh '''
                    echo "🚀 Pushing to GitHub..."
                    git config --global user.email "ayzazkhan82@gmail.com"
                    git config --global user.name "Ayzazkhan"
                    git add website_analysis.json final_content.json
                    git commit -m "Auto-generated: 175 brand-style content pieces [Jenkins Build ${BUILD_NUMBER}]" || echo "No changes"
                    git push origin main || echo "Push failed"
                    echo "✅ Process completed!"
                    '''
                }
            }
        }
    }

    post {
        always {
            dir('content-generation') {
                sh '''
                echo "🧹 Cleaning up..."
                rm -rf venv
                echo "📁 Final files:"
                ls -la *.json
                echo "📊 Final stats:"
                python3 -c "
import json
data = json.load(open('final_content.json'))
print(f'🎯 {len(data)} content pieces generated')
print(f'🔗 {sum(item[\\\"links_count\\\"] for item in data)} total links')
print(f'📝 {sum(item[\\\"word_count\\\"] for item in data)} total words')
"
                '''
            }
            archiveArtifacts artifacts: 'content-generation/final_content.json', fingerprint: true
        }
        success {
            echo "🎉 SUCCESS! 175 brand-style content pieces generated!"
        }
    }
}
