        stage('Google Search & Competitor Analysis') {
            steps {
                dir('content-generation') {
                    sh '''
                    echo "🔍 Analyzing Competitors via Google Search..."
                    . venv/bin/activate
                    
                    python3 - << 'EOF'
import json
import requests
from bs4 import BeautifulSoup
import re
import time
from urllib.parse import quote_plus, urlparse

print("=" * 70)
print("🔍 GOOGLE SEARCH POWERED ANALYSIS")
print("=" * 70)

# Load base config
with open("content.json", "r") as f:
    config = json.load(f)

domain = config.get("target_domain", "hesiexamtaker.com")
niche = config.get("niche", "hesi exam help")

print(f"🌐 Target Domain: {domain}")
print(f"🎯 Niche: {niche}")

def google_search(query, num_results=10):
    """Google search karke URLs nikalo (FREE, no API)"""
    search_url = f"https://www.google.com/search?q={quote_plus(query)}&num={num_results}"
    headers = {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
    }
    
    try:
        response = requests.get(search_url, headers=headers, timeout=15)
        soup = BeautifulSoup(response.content, 'html.parser')
        
        urls = []
        for link in soup.find_all('a'):
            href = link.get('href', '')
            if '/url?q=' in href:
                url = href.split('/url?q=')[1].split('&')[0]
                if url.startswith('http') and domain not in url:
                    urls.append(url)
        
        return list(set(urls))[:5]  # Top 5 unique competitors
    except Exception as e:
        print(f"⚠️ Google search error: {e}")
        return []

def scrape_competitor_content(url):
    """Competitor ka complete content nikalo"""
    try:
        headers = {'User-Agent': 'Mozilla/5.0'}
        response = requests.get(url, headers=headers, timeout=15)
        soup = BeautifulSoup(response.content, 'html.parser')
        
        # Remove script, style tags
        for tag in soup(['script', 'style', 'nav', 'footer', 'header']):
            tag.decompose()
        
        # Extract all text
        text_content = []
        
        # Title
        if soup.title:
            text_content.append(soup.title.get_text())
        
        # Meta description
        meta = soup.find('meta', attrs={'name': 'description'})
        if meta:
            text_content.append(meta.get('content', ''))
        
        # Headers & paragraphs
        for tag in ['h1', 'h2', 'h3', 'p']:
            for element in soup.find_all(tag):
                text = element.get_text().strip()
                if len(text) > 20:
                    text_content.append(text)
        
        return ' '.join(text_content)
    except:
        return ""

def extract_keywords_from_text(text):
    """Text se automatically keywords nikalo"""
    # Remove common words
    stop_words = {'the', 'is', 'at', 'which', 'on', 'a', 'an', 'and', 'or', 'but', 'in', 'with', 'to', 'for'}
    
    # Extract 2-4 word phrases
    words = re.findall(r'\b[a-zA-Z]{3,}\b', text.lower())
    
    keywords = []
    for i in range(len(words) - 3):
        phrase = ' '.join(words[i:i+3])
        if not any(sw in phrase.split() for sw in stop_words):
            keywords.append(phrase)
    
    # Count frequency
    keyword_freq = {}
    for kw in keywords:
        keyword_freq[kw] = keyword_freq.get(kw, 0) + 1
    
    # Return top keywords
    top_keywords = sorted(keyword_freq.items(), key=lambda x: x[1], reverse=True)
    return [kw for kw, freq in top_keywords[:50] if freq >= 2]

def extract_anchor_texts(soup):
    """Natural anchor texts nikalo"""
    anchors = []
    for link in soup.find_all('a'):
        text = link.get_text().strip()
        if 5 < len(text) < 50 and not text.isupper():
            anchors.append(text)
    return list(set(anchors))[:30]

print("\n🔍 STEP 1: Google search karke competitors dhund rahe hain...")
search_queries = [
    f"{niche}",
    f"best {niche}",
    f"professional {niche}",
    f"{niche} services"
]

all_competitor_urls = []
for query in search_queries:
    print(f"   Searching: {query}")
    urls = google_search(query)
    all_competitor_urls.extend(urls)
    time.sleep(2)  # Rate limiting

competitor_urls = list(set(all_competitor_urls))[:10]
print(f"✅ Found {len(competitor_urls)} competitor URLs")

print("\n📊 STEP 2: Competitors ka content analyze kar rahe hain...")
all_content = ""
all_keywords = []
all_anchors = []

for i, url in enumerate(competitor_urls, 1):
    print(f"   [{i}/{len(competitor_urls)}] Analyzing: {urlparse(url).netloc}")
    
    content = scrape_competitor_content(url)
    if content:
        all_content += " " + content
        
        # Parse again for anchors
        try:
            response = requests.get(url, timeout=10)
            soup = BeautifulSoup(response.content, 'html.parser')
            anchors = extract_anchor_texts(soup)
            all_anchors.extend(anchors)
        except:
            pass
    
    time.sleep(1)

print(f"✅ Total content collected: {len(all_content)} characters")

print("\n🎯 STEP 3: Keywords extract kar rahe hain...")
extracted_keywords = extract_keywords_from_text(all_content)
print(f"✅ Extracted {len(extracted_keywords)} keywords")

print("\n🔗 STEP 4: Anchor texts extract kar rahe hain...")
unique_anchors = list(set(all_anchors))
print(f"✅ Extracted {len(unique_anchors)} anchor texts")

# Analyze writing patterns
print("\n📝 STEP 5: Writing patterns analyze kar rahe hain...")

sentences = re.split(r'[.!?]+', all_content)
clean_sentences = [s.strip() for s in sentences if 20 < len(s.strip()) < 150]

# Sentence starters
starters = []
for sent in clean_sentences[:100]:
    words = sent.split()
    if words:
        starters.append(words[0])

from collections import Counter
common_starters = [word for word, count in Counter(starters).most_common(15)]

# Create comprehensive analysis
analysis_data = {
    'competitor_analysis': {
        'competitor_count': len(competitor_urls),
        'total_content_size': len(all_content),
        'keywords_extracted': len(extracted_keywords),
        'anchors_extracted': len(unique_anchors)
    },
    'keywords': extracted_keywords,
    'anchor_texts': unique_anchors,
    'sample_sentences': clean_sentences[:50],
    'writing_patterns': {
        'common_starters': common_starters,
        'avg_sentence_length': sum(len(s.split()) for s in clean_sentences) / len(clean_sentences) if clean_sentences else 12,
        'tone_indicators': ['professional', 'helpful', 'expert']
    },
    'competitor_urls': competitor_urls
}

# Save analysis
with open("google_analysis.json", "w") as f:
    json.dump(analysis_data, f, indent=2)

print("\n" + "=" * 70)
print("✅ GOOGLE ANALYSIS COMPLETE!")
print("=" * 70)
print(f"📊 Statistics:")
print(f"   - Competitors analyzed: {len(competitor_urls)}")
print(f"   - Keywords found: {len(extracted_keywords)}")
print(f"   - Anchor texts: {len(unique_anchors)}")
print(f"   - Sample sentences: {len(clean_sentences)}")
print(f"\n📝 Top 5 Keywords:")
for kw in extracted_keywords[:5]:
    print(f"   - {kw}")
print(f"\n🔗 Top 5 Anchor Texts:")
for anchor in unique_anchors[:5]:
    print(f"   - {anchor}")

EOF
                    '''
                }
            }
        }

        stage('Generate SEO Expert Content') {
            steps {
