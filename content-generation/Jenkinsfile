            'quality_links': quality_links,
            'primary_domain': domain
        }
    }
    
    with open('smart_analysis.json', 'w') as f:
        json.dump(analysis_data, f, indent=2)
    
    print('🎯 ANALYSIS COMPLETE!')
    print(f'   - Natural sentences: {len(natural_sentences)}')
    print(f'   - Quality links: {len(quality_links)}')
    print(f'   - Detected tones: {writing_patterns[\\\"tone\\\"]}')
    
    # Show samples
    if natural_sentences:
        print('\\n📝 SAMPLE SENTENCES:')
        for i, sentence in enumerate(natural_sentences[:3]):
            print(f'   {i+1}. {sentence}')

except Exception as e:
