pipeline {
    agent any

    stages {
        stage('Setup Optimized Environment') {
            steps {
                dir('content-generation') {
                    sh '''
                    echo "🚀 Installing Optimized Libraries..."
                    python3 -m venv venv || python -m venv venv
                    . venv/bin/activate
                    pip install --upgrade pip
                    
                    # Optimized libraries - lighter versions
                    pip install transformers
                    pip install torch --index-url https://download.pytorch.org/whl/cpu
                    pip install requests beautifulsoup4
                    
                    echo "✅ Optimized Libraries Installed"
                    '''
                }
            }
        }

        stage('Create Optimized Content Generator') {
            steps {
                dir('content-generation') {
                    writeFile file: 'optimized_generator.py', text: '''import json
import random
import re
from collections import defaultdict

print("=" * 80)
print("🚀 OPTIMIZED CONTENT GENERATION")
print("=" * 80)

class OptimizedContentGenerator:
    def __init__(self):
        print("🛠️ Initializing Optimized Generator...")
        
    def generate_intelligent_content(self, keyword):
        """Generate intelligent content using advanced templates"""
        
        # Professional content templates
        professional_templates = [
            f"Get expert {keyword} assistance from qualified professionals. Our team provides comprehensive support tailored to your academic needs with guaranteed quality results.",
            f"Struggling with {keyword}? Our experienced specialists offer reliable solutions and professional guidance to help you achieve academic success.",
            f"Need professional {keyword} help? We provide top-quality services with expert support, ensuring you get the best possible outcomes.",
            f"Excel in your studies with our {keyword} services. Receive professional assistance and comprehensive support from industry experts.",
            f"Access premium {keyword} solutions from our qualified team. We offer expert guidance and reliable support for all your academic requirements."
        ]
        
        # Benefit-focused templates
        benefit_templates = [
            f"Achieve better grades with our {keyword} services. Get personalized assistance and expert support for improved academic performance.",
            f"Save time and reduce stress with professional {keyword} help. Our experts provide quality solutions for your academic challenges.",
            f"Improve your understanding with comprehensive {keyword} support. Receive detailed explanations and expert guidance.",
            f"Boost your confidence with reliable {keyword} assistance. Our professional team ensures quality results and academic success.",
            f"Enhance your skills with expert {keyword} guidance. Learn from qualified professionals and achieve your academic goals."
        ]
        
        # Service-focused templates
        service_templates = [
            f"Our {keyword} services include professional assistance, expert guidance, and comprehensive support for all your academic needs.",
            f"We offer specialized {keyword} solutions with quality assurance, timely delivery, and professional expertise.",
            f"Experience premium {keyword} services featuring expert support, customized solutions, and guaranteed satisfaction.",
            f"Choose our {keyword} assistance for professional quality, reliable support, and academic excellence.",
            f"Benefit from our comprehensive {keyword} services including expert help, detailed solutions, and professional guidance."
        ]
        
        # Combine all templates
        all_templates = professional_templates + benefit_templates + service_templates
        
        return random.choice(all_templates)
    
    def enhance_content_quality(self, content):
        """Enhance content quality with natural variations"""
        
        # Add natural sentence variations
        variations = [
            " Contact us today for professional assistance.",
            " Get started with our expert team now.",
            " Reach out for personalized support.",
            " Let our experts help you succeed.",
            " Discover how we can assist you."
        ]
        
        # 50% chance to add variation
        if random.random() < 0.5:
            content += random.choice(variations)
        
        return content

# Load analysis data
print("📂 Loading analysis data...")
try:
    with open("advanced_analysis.json", "r") as f:
        analysis = json.load(f)
    
    keywords = analysis.get("seo_optimization", {}).get("keywords", [])
    anchors = analysis.get("seo_optimization", {}).get("anchor_texts", [])
    domain = analysis.get("generation_parameters", {}).get("target_domain", "economicsassignmenthelp.co.uk")
    
    if not keywords:
        keywords = [
            "economics assignment help", "economics homework help",
            "economics paper writing", "economic research assistance",
            "microeconomics help", "macroeconomics assistance",
            "econometrics support", "economic analysis help"
        ]
    
    if not anchors:
        anchors = ["Learn More", "Get Started", "View Services", "Contact Us", "Get Help"]
        
except Exception as e:
    print(f"❌ Error loading analysis: {e}")
    keywords = ["economics assignment help", "academic writing services"]
    anchors = ["Learn More", "Get Started"]
    domain = "economicsassignmenthelp.co.uk"

print(f"📊 Generation Parameters:")
print(f"   • Keywords: {len(keywords)}")
print(f"   • Anchors: {len(anchors)}")
print(f"   • Domain: {domain}")

class SmartContentPipeline:
    def __init__(self, keywords, anchors, domain):
        self.keywords = keywords
        self.anchors = anchors
        self.domain = domain
        self.generator = OptimizedContentGenerator()
        
    def create_seo_slug(self, text):
        """Create SEO-friendly slugs"""
        slug = text.lower().replace(' ', '-')
        slug = re.sub(r'[^a-z0-9-]', '', slug)
        return slug[:30]
    
    def generate_content_piece(self):
        """Generate one optimized content piece"""
        keyword = random.choice(self.keywords)
        
        # Select anchors intelligently
        available_anchors = [a for a in self.anchors if 5 <= len(a) <= 35]
        if len(available_anchors) >= 2:
            anchor1 = random.choice(available_anchors)
            anchor2 = random.choice([a for a in available_anchors if a != anchor1])
        else:
            anchor1, anchor2 = "Learn More", "Get Started"
        
        # Generate intelligent content
        base_content = self.generator.generate_intelligent_content(keyword)
        enhanced_content = self.generator.enhance_content_quality(base_content)
        
        # Create slugs
        slug1 = self.create_seo_slug(keyword)
        slug2 = self.create_seo_slug(random.choice(self.keywords))
        
        # Build final content with strategic linking
        content_parts = enhanced_content.split('. ')
        if len(content_parts) >= 2:
            # Insert first link in second sentence
            content_parts[1] += f" <a href='https://{self.domain}/{slug1}'>{anchor1}</a>"
            
            # Insert second link (60% chance)
            if random.random() < 0.6 and len(content_parts) >= 3:
                content_parts[2] += f" <a href='https://{self.domain}/{slug2}'>{anchor2}</a>"
            elif len(content_parts) == 2:
                # Add second link to first sentence if only 2 sentences
                content_parts[0] += f" <a href='https://{self.domain}/{slug2}'>{anchor2}</a>"
        
        final_content = '. '.join(content_parts)
        
        return final_content, keyword, [anchor1, anchor2]
    
    def calculate_quality_score(self, content, word_count, links_count):
        """Calculate intelligent quality score"""
        score = 0
        
        # Word count optimization
        if 30 <= word_count <= 55:
            score += 2
        elif 25 <= word_count <= 60:
            score += 1
        
        # Strategic linking
        if links_count == 2:
            score += 2
        elif links_count == 1:
            score += 1
        
        # Content quality indicators
        quality_indicators = ['professional', 'expert', 'help', 'support', 'quality', 'comprehensive']
        indicator_count = sum(1 for indicator in quality_indicators if indicator in content.lower())
        
        if indicator_count >= 3:
            score += 2
        elif indicator_count >= 2:
            score += 1
        
        # Readability check (simple)
        sentences = content.split('. ')
        if len(sentences) >= 2 and all(len(sentence.split()) <= 25 for sentence in sentences):
            score += 1
        
        if score >= 6:
            return "excellent"
        elif score >= 4:
            return "very good"
        elif score >= 3:
            return "good"
        else:
            return "satisfactory"
    
    def generate_batch(self, count=175):
        """Generate optimized content batch"""
        print(f"\\n🎯 GENERATING {count} OPTIMIZED CONTENT PIECES...")
        
        if not self.keywords:
            print("❌ No keywords available")
            return []
        
        try:
            max_uses = max(2, count // len(self.keywords))
        except:
            max_uses = 10
        
        generated_data = []
        keyword_usage = defaultdict(int)
        
        for i in range(count):
            try:
                # Smart keyword distribution
                available_keywords = [k for k in self.keywords if keyword_usage[k] < max_uses]
                if not available_keywords:
                    available_keywords = self.keywords
                
                keyword = random.choice(available_keywords)
                keyword_usage[keyword] += 1
                
                # Generate content
                content, keyword, anchors = self.generate_content_piece()
                
                # Calculate metrics
                word_count = len(content.split())
                links_count = content.count('<a href')
                
                # Quality assessment
                quality_score = self.calculate_quality_score(content, word_count, links_count)
                
                generated_data.append({
                    'id': i + 1,
                    'keyword': keyword,
                    'content': content,
                    'word_count': word_count,
                    'links_count': links_count,
                    'anchor_texts': anchors,
                    'quality_score': quality_score,
                    'seo_optimized': True
                })
                
                if (i + 1) % 25 == 0:
                    print(f"  ✅ {i + 1}/{count} - {keyword}")
                    
            except Exception as e:
                print(f"  ⚠️ Error in piece {i+1}: {e}")
                continue
        
        return generated_data

# Initialize and generate content
print("\\n🔄 Initializing Smart Content Pipeline...")
pipeline = SmartContentPipeline(keywords, anchors, domain)

print("\\n🚀 STARTING OPTIMIZED CONTENT GENERATION...")
content_data = pipeline.generate_batch(175)

# Save results
output_file = "optimized_content.json"
with open(output_file, "w") as f:
    json.dump(content_data, f, indent=2)

print("\\n" + "=" * 80)
print("🎉 OPTIMIZED CONTENT GENERATION COMPLETE")
print("=" * 80)

# Comprehensive analytics
if content_data:
    total_pieces = len(content_data)
    total_words = sum(item['word_count'] for item in content_data)
    total_links = sum(item['links_count'] for item in content_data)
    
    quality_dist = defaultdict(int)
    link_dist = defaultdict(int)
    
    for item in content_data:
        quality_dist[item['quality_score']] += 1
        link_dist[item['links_count']] += 1
    
    print(f"📊 PERFORMANCE ANALYTICS:")
    print(f"   • Total Pieces: {total_pieces}")
    print(f"   • Average Words: {total_words/total_pieces:.1f}")
    print(f"   • Total Links: {total_links}")
    print(f"   • Average Links per Piece: {total_links/total_pieces:.1f}")
    
    print(f"\\n🏆 QUALITY DISTRIBUTION:")
    for quality, count in sorted(quality_dist.items(), 
                               key=lambda x: ['satisfactory', 'good', 'very good', 'excellent'].index(x[0])):
        percentage = (count / total_pieces) * 100
        print(f"   • {quality.title()}: {count} pieces ({percentage:.1f}%)")
    
    print(f"\\n🔗 LINK DISTRIBUTION:")
    for links, count in sorted(link_dist.items()):
        percentage = (count / total_pieces) * 100
        print(f"   • {links} links: {count} pieces ({percentage:.1f}%)")
    
    print(f"\\n📝 CONTENT SAMPLES:")
    print("=" * 50)
    excellent_samples = [item for item in content_data if item['quality_score'] == 'excellent']
    if excellent_samples:
        for i in range(min(2, len(excellent_samples))):
            sample = excellent_samples[i]
            print(f"\\n--- Sample {i+1} [Excellent Quality] ---")
            print(f"Keyword: {sample['keyword']}")
            print(f"Content: {sample['content']}")
            print(f"Metrics: {sample['word_count']} words, {sample['links_count']} links")
            print()
    else:
        for i in range(min(2, len(content_data))):
            sample = content_data[i]
            print(f"\\n--- Sample {i+1} [{sample['quality_score'].title()}] ---")
            print(f"Keyword: {sample['keyword']}")
            print(f"Content: {sample['content'][:120]}...")
            print(f"Metrics: {sample['word_count']} words, {sample['links_count']} links")
            print()
    
    print(f"💾 Optimized content saved to: {output_file}")
else:
    print("❌ No content was generated")
'''
                }
            }
        }

        stage('Generate Optimized Content') {
            steps {
                dir('content-generation') {
