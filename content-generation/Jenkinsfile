                    echo "📊 Generating Final Quality Report..."
                    . venv/bin/activate
                    python3 -c "
import json

print('🎯 FINAL CONTENT GENERATION REPORT')
print('=' * 60)

try:
    # Load validation report
    with open('quality_validation_report.json', 'r') as f:
        report = json.load(f)
    
    # Load content stats
    with open('quality_content.json', 'r') as f:
        content = json.load(f)
    
    print(f'✅ GENERATION SUCCESSFUL!')
    print(f'📦 Total Pieces: {len(content)}')
    print(f'🏆 Overall Quality Score: {report[\\\"overall_quality_score\\\"]}/100')
    print(f'📝 Average Words: {report[\\\"word_count_analysis\\\"][\\\"average\\\"]:.1f}')
    print(f'🔗 Average Links: {report[\\\"link_analysis\\\"][\\\"average_links\\\"]:.1f}')
    
    print(f'\\n🎯 QUALITY BREAKDOWN:')
    for quality, count in report['quality_distribution'].items():
        percentage = (count / len(content)) * 100
        print(f'   • {quality.title()}: {count} pieces ({percentage:.1f}%)')
    
    print(f'\\n💡 RECOMMENDATIONS:')
    for rec in report['recommendations'][:3]:
        print(f'   • {rec}')
    
