import json
import requests
from bs4 import BeautifulSoup
import re
from collections import Counter
import urllib.parse

print('=' * 60)
print('🔍 ADVANCED WEBSITE ANALYSIS')
print('=' * 60)

# Load config
try:
    with open('content.json', 'r') as f:
        config = json.load(f)
    domain = config.get('target_domain', 'hesiexamtaker.com')
    print(f'🌐 Analyzing: {domain}')
except:
    domain = 'hesiexamtaker.com'
    print('⚠️ Using default domain:', domain)

def extract_natural_patterns(soup, url):
    all_content = []
    natural_phrases = []
    
    for tag in ['p', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'li', 'span', 'div']:
        elements = soup.find_all(tag)
        for element in elements:
            text = element.get_text().strip()
            if len(text) > 20 and not any(x in text.lower() for x in ['cookie', 'privacy', 'terms']):
                all_content.append(text)
                sentences = re.split(r'[.!?]+', text)
                for sentence in sentences:
                    clean_sentence = sentence.strip()
                    if 10 < len(clean_sentence) < 100:
                        natural_phrases.append(clean_sentence)
    
    return all_content, natural_phrases

def analyze_content_structure(all_content):
    word_freq = Counter()
    sentence_patterns = []
    
    for content in all_content:
        words = re.findall(r'\\b[a-zA-Z]{3,}\\b', content.lower())
        word_freq.update(words)
        
        sentences = re.split(r'[.!?]+', content)
        for sentence in sentences:
            words_in_sentence = sentence.strip().split()
            if 5 <= len(words_in_sentence) <= 25:
                sentence_patterns.append({
                    'length': len(words_in_sentence),
                    'start_word': words_in_sentence[0].lower() if words_in_sentence else '',
                    'has_question': '?' in sentence
                })
    
    return word_freq, sentence_patterns

def extract_key_phrases(word_freq, top_n=50):
    stop_words = {'the', 'and', 'for', 'with', 'this', 'that', 'are', 'from', 'have', 'has', 'had'}
    meaningful_words = [(word, count) for word, count in word_freq.most_common() 
                       if word not in stop_words and count > 1]
    return [word for word, count in meaningful_words[:top_n]]

def extract_content_themes(content_list):
    themes = []
    all_text = ' '.join(content_list).lower()
    
    theme_keywords = {
        'exam_preparation': ['exam', 'test', 'preparation', 'study'],
        'nursing_education': ['nursing', 'nurse', 'medical', 'healthcare'],
        'test_strategies': ['strategy', 'tip', 'technique', 'method'],
        'academic_support': ['help', 'support', 'guidance', 'assistance']
    }
    
    for theme, keywords in theme_keywords.items():
        if any(keyword in all_text for keyword in keywords):
            themes.append(theme)
    
    return themes if themes else ['exam_preparation', 'academic_support']

def analyze_writing_style(content_list):
    if not content_list:
        return 'professional_conversational'
    
    sample_text = ' '.join(content_list[:3]).lower()
    
    if any(word in sample_text for word in ['we', 'our', 'us']):
        return 'conversational_professional'
    elif any(word in sample_text for word in ['students', 'learners']):
        return 'educational_engaging'
    else:
        return 'professional_conversational'

try:
    headers = {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
        'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8'
    }
    
    main_url = f'https://{domain}'
    print(f'📄 Analyzing main page: {main_url}')
    
    response = requests.get(main_url, headers=headers, timeout=15)
    soup = BeautifulSoup(response.content, 'html.parser')
    
    all_site_content, natural_phrases = extract_natural_patterns(soup, main_url)
    
    all_links = []
    links = soup.find_all('a', href=True)
    for link in links:
        href = link.get('href')
        link_text = link.get_text().strip()
        if href and len(link_text) > 3:
            if href.startswith('/'):
                full_url = f'https://{domain}{href}'
            elif domain in href:
                full_url = href
            else:
                continue
            all_links.append({
                'text': link_text,
                'url': full_url
            })
    
    print(f'✅ Found {len(all_links)} internal links')
    
    word_freq, sentence_patterns = analyze_content_structure(all_site_content)
    key_phrases = extract_key_phrases(word_freq)
    
    analysis_data = {
        'brand_voice_characteristics': {
            'sentence_length_avg': sum(p['length'] for p in sentence_patterns) / len(sentence_patterns) if sentence_patterns else 12,
            'question_frequency': sum(1 for p in sentence_patterns if p['has_question']) / len(sentence_patterns) if sentence_patterns else 0.1,
            'common_starters': Counter(p['start_word'] for p in sentence_patterns).most_common(10)
        },
        'content_patterns': {
            'natural_phrases': natural_phrases[:100],
            'key_phrases': key_phrases,
            'common_structures': sentence_patterns[:50]
        },
        'site_structure': {
            'internal_links': all_links[:15],
            'content_themes': extract_content_themes(all_site_content),
            'writing_style': analyze_writing_style(all_site_content)
        }
    }
    
    with open('deep_analysis.json', 'w') as f:
        json.dump(analysis_data, f, indent=2)
    
    print('✅ DEEP ANALYSIS COMPLETE!')
    print(f'   - Natural phrases: {len(natural_phrases)}')
    print(f'   - Key phrases: {len(key_phrases)}')
    print(f'   - Internal links: {len(all_links)}')
    
except Exception as e:
    print(f'❌ Deep analysis failed: {e}')
    
    fallback_data = {
        'brand_voice_characteristics': {
            'sentence_length_avg': 14,
            'question_frequency': 0.15,
            'common_starters': [('get', 8), ('learn', 6), ('discover', 5), ('find', 4), ('achieve', 4)]
        },
        'content_patterns': {
            'natural_phrases': [
                'Get professional help with your HESI exam preparation',
                'Our expert team provides comprehensive nursing exam support',
                'Achieve better scores with our specialized test strategies',
                'Learn effective techniques for nursing exam success',
                'Find the right support for your healthcare career goals'
            ],
            'key_phrases': ['hesi', 'exam', 'nursing', 'preparation', 'scores', 'professional', 'help', 'study', 'test', 'success'],
            'common_structures': [
                {'length': 12, 'start_word': 'get', 'has_question': False},
                {'length': 10, 'start_word': 'our', 'has_question': False},
                {'length': 8, 'start_word': 'achieve', 'has_question': False}
            ]
        },
        'site_structure': {
            'internal_links': [
                {'text': 'HESI Exam Help', 'url': f'https://{domain}/services'},
                {'text': 'Nursing Test Prep', 'url': f'https://{domain}/nursing'},
                {'text': 'Study Materials', 'url': f'https://{domain}/materials'},
                {'text': 'Contact Support', 'url': f'https://{domain}/contact'}
            ],
            'content_themes': ['exam_preparation', 'nursing_education', 'academic_support'],
            'writing_style': 'professional_conversational'
        }
    }
    with open('deep_analysis.json', 'w') as f:
        json.dump(fallback_data, f, indent=2)
    print('⚠️ Using intelligent fallback analysis data')

print('💾 Analysis saved to deep_analysis.json')
"
