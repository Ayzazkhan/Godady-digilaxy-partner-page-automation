pipeline {
    agent any

    stages {
        stage('Setup') {
            steps {
                sh '''
                echo "📦 Installing dependencies..."
                pip3 install --user requests beautifulsoup4 || pip install --user requests beautifulsoup4
                '''
            }
        }

        stage('Checkout Repository') {
            steps {
                script {
                    // Clone or update repository
                    sh '''
                    if [ -d "content-generation" ]; then
                        cd content-generation
                        git pull origin main || true
                    else
                        git clone https://github.com/YOUR_USERNAME/content-generation.git
                    fi
                    '''
                }
            }
        }

        stage('Smart Website Analysis') {
            steps {
                dir('content-generation') {
                    sh '''
                    echo "🔍 SMART WEBSITE ANALYSIS..."
                    python3 -c "
import json
import requests
from bs4 import BeautifulSoup
import re
from collections import Counter

print('=' * 60)
print('🔍 SMART CONTENT EXTRACTION')
print('=' * 60)

# Load config
try:
    with open('content.json', 'r') as f:
        config = json.load(f)
    domain = config.get('target_domain', 'hesiexamtaker.com')
    print(f'🌐 Analyzing: {domain}')
except:
    domain = 'hesiexamtaker.com'
    print('⚠️ Using default domain:', domain)

def clean_text(text):
    text = re.sub(r'\\s+', ' ', text)
    text = re.sub(r'\\b(HOME|ABOUT|SERVICES|CONTACT|MENU)\\b', '', text, flags=re.IGNORECASE)
    return text.strip()

def extract_quality_content(soup):
    quality_content = []
    content_selectors = [
        'main p', '.content p', '.post-content p', 
        'article p', '.description p'
    ]
    
    for selector in content_selectors:
        paragraphs = soup.select(selector)
        for p in paragraphs:
            text = clean_text(p.get_text())
            if len(text) > 50 and len(text) < 500:
                quality_content.append(text)
    
    return quality_content

try:
    headers = {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
    }
    
    main_url = f'https://{domain}'
    response = requests.get(main_url, headers=headers, timeout=15)
    soup = BeautifulSoup(response.content, 'html.parser')
    
    quality_content = extract_quality_content(soup)
    
    analysis_data = {
        'quality_content': {
            'natural_sentences': quality_content[:50],
            'writing_patterns': {
                'tone': ['professional', 'helpful'],
                'avg_sentence_length': 12
            }
        },
        'site_structure': {
            'quality_links': [
                {'text': 'HESI Services', 'url': f'https://{domain}/services'}
            ],
            'primary_domain': domain
        }
    }
    
    with open('smart_analysis.json', 'w') as f:
        json.dump(analysis_data, f, indent=2)
    
    print('🎯 Analysis complete!')

except Exception as e:
    print(f'❌ Error: {e}')
    # Create fallback data
    fallback_data = {
        'quality_content': {
            'natural_sentences': ['Professional HESI exam assistance'],
            'writing_patterns': {'tone': ['professional']}
        },
        'site_structure': {'quality_links': [], 'primary_domain': domain}
    }
    with open('smart_analysis.json', 'w') as f:
        json.dump(fallback_data, f, indent=2)
"
                    '''
                }
            }
        }

        stage('Content Generation') {
            steps {
                dir('content-generation') {
                    sh '''
                    echo "🚀 GENERATING CONTENT..."
                    python3 -c "
import json
import random

print('🚀 Professional Content Generation')

# Load analysis
with open('smart_analysis.json', 'r') as f:
    analysis = json.load(f)

# Load keywords
try:
    with open('content.json', 'r') as f:
        config = json.load(f)
    keywords = config.get('keywords', ['HESI exam help'])
except:
    keywords = ['HESI exam help', 'nursing test prep']

generated_data = []

for i in range(175):
    keyword = random.choice(keywords)
    content = f'Professional assistance with {keyword}. Our expert team provides comprehensive support.'
    
    generated_data.append({
        'id': i + 1,
        'keyword': keyword,
        'content': content,
        'word_count': len(content.split()),
        'links_count': 0
    })

with open('professional_content.json', 'w') as f:
    json.dump(generated_data, f, indent=2)

print(f'✅ Generated {len(generated_data)} pieces')
"
                    '''
                }
            }
        }

        stage('Push to GitHub') {
            steps {
                dir('content-generation') {
                    sh '''
                    git config user.email "ayzazkhan82@gmail.com"
                    git config user.name "Ayzazkhan"
                    git add *.json
                    git commit -m "Content: Build ${BUILD_NUMBER}" || echo "No changes"
                    git push origin main || echo "Push failed - check credentials"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline completed successfully!"
        }
        failure {
            echo "❌ Pipeline failed - check logs"
        }
    }
}
