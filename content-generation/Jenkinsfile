                {'text': 'HESI Exam Services', 'url': f'https://{domain}/services'},
                {'text': 'Nursing Test Help', 'url': f'https://{domain}/nursing'},
                {'text': 'Get Started Today', 'url': f'https://{domain}/get-started'},
                {'text': 'Contact Our Experts', 'url': f'https://{domain}/contact'}
            ],
