import json
import random
import re
from collections import defaultdict

print('=' * 60)
print('🚀 PROFESSIONAL CONTENT GENERATION')
print('=' * 60)

# Load smart analysis
try:
    with open('smart_analysis.json', 'r') as f:
        analysis = json.load(f)
    print('✅ Loaded smart analysis data')
except Exception as e:
    print(f'❌ Failed to load analysis: {e}')
    exit(1)

# Load keywords
try:
    with open('content.json', 'r') as f:
        config = json.load(f)
    keywords = config.get('keywords', [])
    print(f'✅ Loaded {len(keywords)} keywords')
except:
    keywords = [
        'HESI exam help',
        'nursing test preparation', 
        'pay someone to take my HESI exam',
        'medical exam assistance',
        'healthcare test support'
    ]
    print('⚠️ Using default keywords')

print(f'📊 Starting generation with:')
print(f'   - Keywords: {len(keywords)}')
print(f'   - Natural sentences: {len(analysis[\\\"quality_content\\\"][\\\"natural_sentences\\\"])}')
print(f'   - Quality links: {len(analysis[\\\"site_structure\\\"][\\\"quality_links\\\"])}')

class ProfessionalContentGenerator:
    def __init__(self, analysis_data):
        self.natural_sentences = analysis_data['quality_content']['natural_sentences']
        self.writing_patterns = analysis_data['quality_content']['writing_patterns']
        self.quality_links = analysis_data['site_structure']['quality_links']
        self.domain = analysis_data['site_structure']['primary_domain']
        
    def create_natural_paragraph(self, keyword):
        '''Create a natural, professional paragraph'''
        
        # Start with a natural sentence from the website
        if self.natural_sentences:
            base_sentence = random.choice(self.natural_sentences)
            # Adapt the sentence to include the keyword naturally
            adapted_sentence = self.adapt_sentence(base_sentence, keyword)
        else:
            # Fallback professional sentence
            adapted_sentence = f'Get professional assistance with {keyword} from our expert team.'
        
        # Build paragraph with 2-3 coherent sentences
        sentences = [adapted_sentence]
        
        # Add supporting sentences
        support_templates = [
            'Our experienced professionals provide comprehensive support tailored to your specific needs.',
            'We offer reliable and confidential services to help you achieve your academic goals.',
            'With our proven strategies and expert guidance, you can approach your exams with confidence.',
            'Our team is dedicated to helping students succeed in their nursing career journey.',
            'We understand the challenges students face and provide effective solutions.'
        ]
        
        num_support_sentences = random.randint(1, 2)
        for _ in range(num_support_sentences):
            support_sentence = random.choice(support_templates)
            sentences.append(support_sentence)
        
        paragraph = ' '.join(sentences)
        return paragraph
    
    def adapt_sentence(self, sentence, keyword):
        '''Adapt a natural sentence to include keyword'''
        words = sentence.split()
        
        # Find a good position to insert/replace with keyword
        if len(words) >= 6:
            # Replace a noun phrase or add the keyword
            possible_positions = [3, 4, 5]  # Middle positions work well
            position = random.choice(possible_positions)
            
            if position < len(words):
                # Check if we're replacing a short word or phrase
                if len(words[position]) <= 8:
                    words[position] = keyword
                else:
                    # Insert before this position
                    words.insert(position, keyword)
        else:
            # For short sentences, append the keyword context
            words.append(f'for {keyword}')
        
        adapted = ' '.join(words)
        return adapted
    
    def integrate_links_naturally(self, content, keyword):
        '''Integrate links in a natural way'''
        if not self.quality_links:
            return content, 0
        
        enhanced_content = content
        links_added = 0
        
        # Always add at least one link
        if self.quality_links:
            link = random.choice(self.quality_links)
            anchor_text = link['text']
            url = link['url']
            
            # Find a natural place to insert the link
            sentences = re.split(r'[.!?]+', content)
            if len(sentences) >= 2:
                # Insert in second sentence for better flow
                target_sentence = sentences[1].strip()
                if target_sentence and len(target_sentence.split()) >= 4:
                    words = target_sentence.split()
                    # Insert link in the middle of the sentence
                    insert_pos = len(words) // 2
                    words.insert(insert_pos, f'<a href=\\"{url}\\">{anchor_text}</a>')
                    sentences[1] = ' '.join(words)
                    links_added += 1
                    
                    enhanced_content = '. '.join(sentences) + '.'
        
        # Possibly add a second link (30% chance)
        if links_added == 1 and len(self.quality_links) > 1 and random.random() < 0.3:
            second_link = random.choice([l for l in self.quality_links if l['text'] != anchor_text])
            if second_link:
                sentences = re.split(r'[.!?]+', enhanced_content)
                if len(sentences) >= 3:
                    target_sentence = sentences[-2].strip()  # Second last sentence
                    if target_sentence and len(target_sentence.split()) >= 3:
                        words = target_sentence.split()
                        insert_pos = random.randint(1, len(words)-1)
                        words.insert(insert_pos, f'<a href=\\"{second_link[\\\"url\\\"]}\\">{second_link[\\\"text\\\"]}</a>')
                        sentences[-2] = ' '.join(words)
                        enhanced_content = '. '.join(sentences) + '.'
                        links_added += 1
        
        return enhanced_content, links_added
    
    def generate_content_piece(self, keyword):
        '''Generate one complete content piece'''
        # Create natural paragraph
        paragraph = self.create_natural_paragraph(keyword)
        
        # Integrate links
        final_content, links_count = self.integrate_links_naturally(paragraph, keyword)
        
        # Ensure proper length
        words = final_content.split()
        if len(words) < 30:
            # Add another sentence
            extra_sentences = [
                'Contact us today to learn more about our services.',
                'Get started with our expert assistance now.',
                'We are here to help you achieve success.'
            ]
            final_content += ' ' + random.choice(extra_sentences)
        elif len(words) > 55:
            # Trim to reasonable length
            words = words[:50]
            final_content = ' '.join(words) + '.'
        
        return final_content.strip(), links_count

# Initialize generator
generator = ProfessionalContentGenerator(analysis)

print('\\n🎯 GENERATING 175 PROFESSIONAL CONTENT PIECES...')
generated_data = []

# Smart keyword distribution
keyword_usage = defaultdict(int)
max_uses_per_keyword = max(2, 175 // len(keywords))

for i in range(175):
    # Select keyword with fair distribution
    available_keywords = [k for k in keywords if keyword_usage[k] < max_uses_per_keyword]
    if not available_keywords:
        available_keywords = keywords
    
    keyword = random.choice(available_keywords)
    keyword_usage[keyword] += 1
    
    # Generate content
    content, links_count = generator.generate_content_piece(keyword)
    
    generated_data.append({
        'id': i + 1,
        'keyword': keyword,
        'content': content,
        'word_count': len(content.split()),
        'links_count': links_count,
        'quality_score': 'high'
    })
    
    if (i + 1) % 25 == 0:
        print(f'✅ Generated {i + 1}/175')

# Save results
with open('professional_content.json', 'w') as f:
    json.dump(generated_data, f, indent=2)

print('\\n🎉 GENERATION COMPLETE!')
print(f'📊 FINAL STATISTICS:')
print(f'   - Total pieces: {len(generated_data)}')
print(f'   - Average words: {sum(item[\\\"word_count\\\"] for item in generated_data)/len(generated_data):.1f}')
print(f'   - Total links: {sum(item[\\\"links_count\\\"] for item in generated_data)}')
print(f'   - Pieces with links: {sum(1 for item in generated_data if item[\\\"links_count\\\"] > 0)}')

print('\\n📋 QUALITY SAMPLES:')
for i in range(3):
    sample = generated_data[i]
    print(f'\\n--- Sample {i+1} ---')
    print(f'Keyword: {sample[\\\"keyword\\\"]}')
    print(f'Content: {sample[\\\"content\\\"]}')
    print(f'Words: {sample[\\\"word_count\\\"]} | Links: {sample[\\\"links_count\\\"]}')
