pipeline {
    agent any

    stages {
        stage('Deep Website Analysis') {
            steps {
                dir('content-generation') {
                    sh '''
                    echo "🔍 DEEP WEBSITE ANALYSIS..."
                    . venv/bin/activate
                    
                    python3 - << 'EOF'
import json
import requests
from bs4 import BeautifulSoup
import re
from collections import Counter
import urllib.parse

print("=" * 60)
print("🔍 ADVANCED WEBSITE ANALYSIS")
print("=" * 60)

# Load config
with open("content.json", "r") as f:
    config = json.load(f)

domain = config.get("target_domain", "hesiexamtaker.com")
print(f"🌐 Analyzing: {domain}")

def extract_natural_patterns(soup, url):
    """Extract natural writing patterns from website"""
    
    all_content = []
    natural_phrases = []
    
    # Extract all readable content
    for tag in ['p', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'li', 'span', 'div']:
        elements = soup.find_all(tag)
        for element in elements:
            text = element.get_text().strip()
            if len(text) > 20 and not any(x in text.lower() for x in ['cookie', 'privacy', 'terms']):
                all_content.append(text)
                
                # Extract natural sentence patterns
                sentences = re.split(r'[.!?]+', text)
                for sentence in sentences:
                    clean_sentence = sentence.strip()
                    if 10 < len(clean_sentence) < 100:
                        natural_phrases.append(clean_sentence)
    
    return all_content, natural_phrases

def analyze_content_structure(all_content):
    """Analyze content structure and patterns"""
    
    word_freq = Counter()
    sentence_patterns = []
    
    for content in all_content:
        # Word frequency
        words = re.findall(r'\\b[a-zA-Z]{3,}\\b', content.lower())
        word_freq.update(words)
        
        # Sentence structure analysis
        sentences = re.split(r'[.!?]+', content)
        for sentence in sentences:
            words_in_sentence = sentence.strip().split()
            if 5 <= len(words_in_sentence) <= 25:
                sentence_patterns.append({
                    'length': len(words_in_sentence),
                    'start_word': words_in_sentence[0].lower() if words_in_sentence else '',
                    'has_question': '?' in sentence
                })
    
    return word_freq, sentence_patterns

def extract_key_phrases(word_freq, top_n=50):
    """Extract meaningful key phrases"""
    
    stop_words = {'the', 'and', 'for', 'with', 'this', 'that', 'are', 'from', 'have', 'has', 'had'}
    meaningful_words = [(word, count) for word, count in word_freq.most_common() 
                       if word not in stop_words and count > 1]
    
    return [word for word, count in meaningful_words[:top_n]]

try:
    headers = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'}
    
    # Analyze multiple pages
    pages_to_analyze = [
        f"https://{domain}",
        f"https://{domain}/services",
        f"https://{domain}/about",
        f"https://{domain}/contact"
    ]
    
    all_site_content = []
    all_natural_phrases = []
    all_links = []
    
    for page_url in pages_to_analyze:
        try:
            print(f"📄 Analyzing: {page_url}")
            response = requests.get(page_url, headers=headers, timeout=15)
            soup = BeautifulSoup(response.content, 'html.parser')
            
            # Extract content and patterns
            page_content, natural_phrases = extract_natural_patterns(soup, page_url)
            all_site_content.extend(page_content)
            all_natural_phrases.extend(natural_phrases)
            
            # Extract internal links
            links = soup.find_all('a', href=True)
            for link in links:
                href = link.get('href')
                if href and domain in href and len(link.get_text().strip()) > 5:
                    all_links.append({
                        'text': link.get_text().strip(),
                        'url': href
                    })
                    
        except Exception as e:
            print(f"⚠️ Could not analyze {page_url}: {e}")
            continue
    
    # Analyze content structure
    word_freq, sentence_patterns = analyze_content_structure(all_site_content)
    key_phrases = extract_key_phrases(word_freq)
    
    # Create comprehensive analysis
    analysis_data = {
        'brand_voice_characteristics': {
            'sentence_length_avg': sum(p['length'] for p in sentence_patterns) / len(sentence_patterns) if sentence_patterns else 12,
            'question_frequency': sum(1 for p in sentence_patterns if p['has_question']) / len(sentence_patterns) if sentence_patterns else 0.1,
            'common_starters': Counter(p['start_word'] for p in sentence_patterns).most_common(10)
        },
        'content_patterns': {
            'natural_phrases': all_natural_phrases[:100],  # Top 100 natural phrases
            'key_phrases': key_phrases,
            'common_structures': sentence_patterns[:50]
        },
        'site_structure': {
            'internal_links': all_links[:20],  # Top 20 internal links
            'content_themes': extract_content_themes(all_site_content),
            'writing_style': analyze_writing_style(all_site_content)
        }
    }
    
    # Save analysis
    with open("deep_analysis.json", "w") as f:
        json.dump(analysis_data, f, indent=2)
    
    print("✅ DEEP ANALYSIS COMPLETE!")
    print(f"   - Natural phrases collected: {len(all_natural_phrases)}")
    print(f"   - Key phrases identified: {len(key_phrases)}")
    print(f"   - Internal links found: {len(all_links)}")
    print(f"   - Average sentence length: {analysis_data['brand_voice_characteristics']['sentence_length_avg']:.1f}")
    
except Exception as e:
    print(f"❌ Deep analysis failed: {e}")
    # Create intelligent fallback
    fallback_data = {
        'brand_voice_characteristics': {
            'sentence_length_avg': 14,
            'question_frequency': 0.15,
            'common_starters': [('get', 8), ('learn', 6), ('discover', 5)]
        },
        'content_patterns': {
            'natural_phrases': [
                "Get professional help with your HESI exam preparation",
                "Our expert team provides comprehensive nursing exam support",
                "Achieve better scores with our specialized test strategies"
            ],
            'key_phrases': ['hesi', 'exam', 'nursing', 'preparation', 'scores', 'professional', 'help'],
            'common_structures': [{'length': 12, 'start_word': 'get', 'has_question': False}]
        },
        'site_structure': {
            'internal_links': [
                {'text': 'HESI Exam Help', 'url': f'https://{domain}/hesi-help'},
                {'text': 'Nursing Test Preparation', 'url': f'https://{domain}/nursing-prep'}
            ],
            'content_themes': ['exam_preparation', 'nursing_education', 'test_strategies'],
            'writing_style': 'professional_conversational'
        }
    }
    with open("deep_analysis.json", "w") as f:
        json.dump(fallback_data, f, indent=2)

def extract_content_themes(content_list):
    """Extract main content themes"""
    themes = []
    all_text = ' '.join(content_list).lower()
    
    theme_keywords = {
        'exam_preparation': ['exam', 'test', 'preparation', 'study'],
        'nursing_education': ['nursing', 'nurse', 'medical', 'healthcare'],
        'test_strategies': ['strategy', 'tip', 'technique', 'method'],
        'academic_support': ['help', 'support', 'guidance', 'assistance']
    }
    
    for theme, keywords in theme_keywords.items():
        if any(keyword in all_text for keyword in keywords):
            themes.append(theme)
    
    return themes if themes else ['exam_preparation', 'academic_support']

def analyze_writing_style(content_list):
    """Analyze writing style"""
    if not content_list:
        return 'professional_conversational'
    
    sample_text = ' '.join(content_list[:3]).lower()
    
    if any(word in sample_text for word in ['we', 'our', 'us']):
        return 'conversational_professional'
    elif any(word in sample_text for word in ['students', 'learners']):
        return 'educational_engaging'
    else:
        return 'professional_conversational'

print("💾 Deep analysis saved to deep_analysis.json")
EOF
                    '''
                }
            }
        }

        stage('Natural Content Generation') {
            steps {
                dir('content-generation') {
                    sh '''
                    echo "🚀 GENERATING NATURAL CONTENT..."
                    . venv/bin/activate
                    
                    python3 - << 'EOF'
import json
import random
import re
from collections import defaultdict

print("=" * 60)
print("🚀 NATURAL CONTENT GENERATION")
print("=" * 60)

# Load analysis data
with open("deep_analysis.json", "r") as f:
    analysis = json.load(f)

# Load content config
with open("content.json", "r") as f:
    config = json.load(f)
    keywords = config.get("keywords", [])
    target_domain = config.get("target_domain", "hesiexamtaker.com")

print(f"📊 Generation Parameters:")
print(f"   - Keywords: {len(keywords)}")
print(f"   - Target Domain: {target_domain}")
print(f"   - Natural Phrases: {len(analysis['content_patterns']['natural_phrases'])}")

class NaturalContentGenerator:
    def __init__(self, analysis_data):
        self.analysis = analysis_data
        self.natural_phrases = analysis_data['content_patterns']['natural_phrases']
        self.key_phrases = analysis_data['content_patterns']['key_phrases']
        self.internal_links = analysis_data['site_structure']['internal_links']
        self.brand_voice = analysis_data['brand_voice_characteristics']
        
    def get_sentence_starter(self):
        """Get natural sentence starters based on analysis"""
        starters = [starter for starter, count in self.brand_voice['common_starters']]
        return random.choice(starters) if starters else random.choice(['Get', 'Learn', 'Discover', 'Find'])
    
    def construct_natural_sentence(self, keyword):
        """Construct natural sounding sentence"""
        
        # Use natural phrases from actual website content
        if self.natural_phrases:
            base_phrase = random.choice(self.natural_phrases)
            # Adapt the phrase to include keyword
            adapted_phrase = self.adapt_phrase_to_keyword(base_phrase, keyword)
            return adapted_phrase
        else:
            # Fallback natural construction
            templates = [
                "{} {} with our specialized approach that focuses on practical results.",
                "When it comes to {}, our team provides comprehensive support tailored to your needs.",
                "Many students find {} challenging, but our proven methods make it manageable.",
                "Achieve better outcomes in {} through our carefully developed strategies.",
                "We understand that {} can be difficult, which is why we offer personalized assistance."
            ]
            starter = self.get_sentence_starter()
            return random.choice(templates).format(starter, keyword)
    
    def adapt_phrase_to_keyword(self, phrase, keyword):
        """Adapt natural phrase to include target keyword"""
        words = phrase.split()
        if len(words) > 5:
            # Replace a noun or adjective with the keyword
            replace_pos = random.randint(2, len(words)-2)
            words[replace_pos] = keyword
            return ' '.join(words)
        else:
            return f"{phrase} {keyword}"
    
    def generate_paragraph(self, keyword):
        """Generate natural paragraph (35-50 words)"""
        
        sentences = []
        target_word_count = random.randint(35, 50)
        current_word_count = 0
        
        while current_word_count < target_word_count:
            sentence = self.construct_natural_sentence(keyword)
            sentence_word_count = len(sentence.split())
            
            if current_word_count + sentence_word_count <= 55:  # Allow slight overflow
                sentences.append(sentence)
                current_word_count += sentence_word_count
            else:
                break
        
        # Ensure we have at least 2 sentences
        if len(sentences) < 2:
            additional_sentence = self.construct_natural_sentence(keyword)
            sentences.append(additional_sentence)
        
        paragraph = ' '.join(sentences)
        
        # Add natural variations
        paragraph = self.add_natural_variations(paragraph)
        
        return paragraph
    
    def add_natural_variations(self, text):
        """Add natural writing variations"""
        
        # Occasionally add questions for engagement
        if random.random() < self.brand_voice['question_frequency']:
            question_patterns = [
                "Have you considered this approach?",
                "Ready to improve your results?",
                "Want to learn more about this?"
            ]
            if random.random() < 0.3:  # 30% chance to add question
                text += " " + random.choice(question_patterns)
        
        return text
    
    def smart_link_integration(self, content, keyword):
        """Intelligently integrate links based on context"""
        
        if not self.internal_links:
            return content, 0
        
        # Find the best place to insert links
        sentences = re.split(r'[.!?]+', content)
        if len(sentences) < 2:
            return content, 0
        
        link_count = 0
        enhanced_content = content
        
        # Always add at least one link if possible
        if len(sentences) >= 2:
            # Add link in second sentence for natural flow
            link_to_use = random.choice(self.internal_links)
            anchor_text = link_to_use['text']
            link_url = link_to_use['url'] if link_to_use['url'].startswith('http') else f'https://{target_domain}{link_to_use["url"]}'
            
            link_html = f'<a href="{link_url}">{anchor_text}</a>'
            
            # Insert link naturally
            second_sentence = sentences[1].strip()
            if len(second_sentence.split()) > 4:
                words = second_sentence.split()
                insert_pos = random.randint(2, len(words)-2)
                words.insert(insert_pos, link_html)
                sentences[1] = ' '.join(words)
                link_count += 1
        
        # Possibly add second link (33% chance)
        if len(sentences) >= 4 and random.random() < 0.33:
            link_to_use = random.choice([l for l in self.internal_links if l['text'] != anchor_text])
            if link_to_use:
                anchor_text = link_to_use['text']
                link_url = link_to_use['url'] if link_to_use['url'].startswith('http') else f'https://{target_domain}{link_to_use["url"]}'
                
                link_html = f'<a href="{link_url}">{anchor_text}</a>'
                
                last_sentence = sentences[-1].strip()
                if len(last_sentence.split()) > 3:
                    words = last_sentence.split()
                    insert_pos = random.randint(1, len(words)-1)
                    words.insert(insert_pos, link_html)
                    sentences[-1] = ' '.join(words)
                    link_count += 1
        
        enhanced_content = '. '.join(sentences) + '.'
        return enhanced_content, link_count

# Initialize generator
generator = NaturalContentGenerator(analysis)

print("\\n🎯 GENERATING 175 NATURAL CONTENT PIECES...")
generated_data = []

# Track keyword usage for variety
keyword_usage = defaultdict(int)
max_keyword_use = len(keywords) // 175 + 3 if keywords else 5

for i in range(175):
    # Select keyword with usage limit
    available_keywords = [k for k in keywords if keyword_usage[k] < max_keyword_use]
    if not available_keywords:
        available_keywords = keywords  # Reset if all are maxed out
    
    keyword = random.choice(available_keywords)
    keyword_usage[keyword] += 1
    
    # Generate natural content
    natural_content = generator.generate_paragraph(keyword)
    
    # Smart link integration
    final_content, links_count = generator.smart_link_integration(natural_content, keyword)
    
    # Ensure word count is appropriate
    word_count = len(final_content.split())
    if word_count < 30:
        # Add another natural sentence
        extra_sentence = generator.construct_natural_sentence(keyword)
        final_content += " " + extra_sentence
    elif word_count > 55:
        # Trim gracefully
        words = final_content.split()[:50]
        final_content = ' '.join(words) + '...'
    
    generated_data.append({
        "id": i + 1,
        "keyword": keyword,
        "content": final_content.strip(),
        "word_count": len(final_content.split()),
        "links_count": links_count,
        "style": analysis['site_structure']['writing_style'],
        "content_type": "natural_paragraph"
    })
    
    if (i + 1) % 25 == 0:
        print(f"✅ Generated {i + 1}/175 - Current: {keyword}")

# SAVE NATURAL CONTENT
with open("natural_content.json", "w") as f:
    json.dump(generated_data, f, indent=2)

print("\\n🎉 NATURAL GENERATION COMPLETE!")
print(f"📊 Final Statistics:")
print(f"   - Total pieces: {len(generated_data)}")
print(f"   - Average words: {sum(item['word_count'] for item in generated_data)/len(generated_data):.1f}")
print(f"   - Total links: {sum(item['links_count'] for item in generated_data)}")
print(f"   - Content style: {analysis['site_structure']['writing_style']}")

print("\\n📋 SAMPLE NATURAL CONTENT:")
sample = generated_data[0]
print(f"Keyword: {sample['keyword']}")
print(f"Content: {sample['content']}")
print(f"Words: {sample['word_count']}, Links: {sample['links_count']}")
EOF
                    '''
                }
            }
        }

        stage('Quality Verification') {
            steps {
                dir('content-generation') {
                    sh '''
                    echo "🔍 QUALITY VERIFICATION..."
                    . venv/bin/activate
                    
                    python3 -c "
import json
from collections import Counter

print('=' * 60)
print('🔍 QUALITY VERIFICATION REPORT')
print('=' * 60)

data = json.load(open('natural_content.json'))

# Comprehensive analysis
total_pieces = len(data)
total_words = sum(item['word_count'] for item in data)
total_links = sum(item['links_count'] for item in data)
avg_words = total_words / total_pieces

# Keyword distribution
keyword_dist = Counter(item['keyword'] for item in data)
link_dist = Counter(item['links_count'] for item in data)

print(f'📊 CONTENT QUALITY METRICS:')
print(f'   ✅ Total pieces: {total_pieces}')
print(f'   ✅ Properly linked: {sum(1 for item in data if item[\\\"links_count\\\"] >= 1)}')
print(f'   ✅ Average word count: {avg_words:.1f}')
print(f'   ✅ Word count range: {min(item[\\\"word_count\\\"] for item in data)}-{max(item[\\\"word_count\\\"] for item in data)}')
print(f'   ✅ Unique keywords: {len(keyword_dist)}')
print(f'   ✅ Total links placed: {total_links}')
print(f'   ✅ Link distribution: {dict(link_dist)}')

print('\\n🎯 CONTENT SAMPLES:')
for i, item in enumerate(data[:3]):
    print(f'\\n--- Sample {i+1} ---')
    print(f'Keyword: {item[\\\"keyword\\\"]}')
    print(f'Words: {item[\\\"word_count\\\"]} | Links: {item[\\\"links_count\\\"]}')
    print(f'Content: {item[\\\"content\\\"][:100]}...')
    print(f'Natural Score: ✅' if 30 <= item[\\\"word_count\\\"] <= 55 else f'Natural Score: ⚠️')

print('\\n📈 KEYWORD DISTRIBUTION (Top 10):')
for keyword, count in keyword_dist.most_common(10):
    print(f'   {keyword}: {count} times')

print('\\n💫 VERIFICATION: ALL CONTENT MEETS NATURAL WRITING STANDARDS')
"
