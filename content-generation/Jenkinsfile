import json
from collections import Counter

print('=' * 60)
print('🔍 PROFESSIONAL QUALITY ASSURANCE')
print('=' * 60)

data = json.load(open('professional_content.json'))

# Comprehensive quality metrics
total_pieces = len(data)
total_words = sum(item['word_count'] for item in data)
total_links = sum(item['links_count'] for item in data)
pieces_with_links = sum(1 for item in data if item['links_count'] > 0)
avg_words = total_words / total_pieces

# Content quality analysis
keyword_dist = Counter(item['keyword'] for item in data)
link_dist = Counter(item['links_count'] for item in data)

# Check for natural language indicators
natural_indicators = sum(1 for item in data if 
    item['word_count'] >= 30 and 
    item['word_count'] <= 55 and
    'HOME' not in item['content'] and
    'ABOUT' not in item['content'] and
    'SERVICES' not in item['content']
)

print(f'📊 QUALITY METRICS:')
print(f'   ✅ Total content pieces: {total_pieces}')
print(f'   ✅ Average word count: {avg_words:.1f}')
print(f'   ✅ Pieces with natural language: {natural_indicators}/{total_pieces}')
print(f'   ✅ Pieces with links: {pieces_with_links}/{total_pieces}')
print(f'   ✅ Total links placed: {total_links}')
print(f'   ✅ Link distribution: {dict(link_dist)}')
print(f'   ✅ Unique keywords used: {len(keyword_dist)}')

