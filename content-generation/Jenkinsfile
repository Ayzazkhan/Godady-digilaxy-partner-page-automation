pipeline {
    agent any

    environment {
        DEEPSEEK_API_KEY = credentials('deepseekfree')   // Your Jenkins Credential ID
    }

    stages {
        stage('Setup Python Env') {
            steps {
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install requests
                '''
            }
        }

        stage('Run Content Generator') {
            steps {
                sh '''
                    . venv/bin/activate
                    python3 content-generation/content_generator.py
                '''
            }
        }

        stage('Archive Results') {
            steps {
                archiveArtifacts artifacts: 'output_content.json', allowEmptyArchive: false
            }
        }
    }
}
