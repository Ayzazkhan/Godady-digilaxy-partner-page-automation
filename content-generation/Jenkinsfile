import json
import requests
from bs4 import BeautifulSoup
import re
from collections import Counter
import urllib.parse

print('=' * 60)
print('🔍 SMART CONTENT EXTRACTION')
print('=' * 60)

# Load config
try:
    with open('content.json', 'r') as f:
        config = json.load(f)
    domain = config.get('target_domain', 'hesiexamtaker.com')
    print(f'🌐 Analyzing: {domain}')
except:
    domain = 'hesiexamtaker.com'
    print('⚠️ Using default domain:', domain)

def clean_text(text):
    '''Clean and normalize text'''
    # Remove extra whitespace, newlines
    text = re.sub(r'\\s+', ' ', text)
    # Remove navigation/menu items
    text = re.sub(r'\\b(HOME|ABOUT|SERVICES|CONTACT|MENU)\\b', '', text, flags=re.IGNORECASE)
    return text.strip()

def extract_quality_content(soup):
    '''Extract only quality content paragraphs'''
    quality_content = []
    
    # Priority 1: Main content paragraphs (avoid headers, footers, nav)
    content_selectors = [
        'main p', '.content p', '.post-content p', '.entry-content p',
        'article p', '.text-block p', '.description p'
    ]
    
    for selector in content_selectors:
        paragraphs = soup.select(selector)
        for p in paragraphs:
            text = clean_text(p.get_text())
            if len(text) > 50 and len(text) < 500:  # Reasonable paragraph length
                quality_content.append(text)
    
    # Priority 2: Regular paragraphs (but filter out navigation)
    all_paragraphs = soup.find_all('p')
    for p in all_paragraphs:
        # Check if this paragraph is likely content (not navigation)
        parent_classes = ' '.join(p.parent.get('class', [])) if p.parent else ''
        parent_id = p.parent.get('id', '') if p.parent else ''
        
        # Skip if likely navigation/footer
        nav_indicators = ['nav', 'menu', 'footer', 'header', 'sidebar']
        if any(indicator in parent_classes.lower() or indicator in parent_id.lower() for indicator in nav_indicators):
            continue
            
        text = clean_text(p.get_text())
        if len(text) > 40 and len(text) < 400 and text not in quality_content:
            quality_content.append(text)
    
    return quality_content

def extract_natural_sentences(quality_content):
    '''Extract complete, natural sentences'''
    natural_sentences = []
    
    for content in quality_content:
        # Split into sentences
        sentences = re.split(r'[.!?]+', content)
        for sentence in sentences:
            clean_sentence = clean_text(sentence)
            # Quality checks for good sentences
            if (20 <= len(clean_sentence) <= 120 and 
                len(clean_sentence.split()) >= 5 and
                not any(word in clean_sentence.upper() for word in ['HOME', 'ABOUT', 'SERVICES', 'CONTACT']) and
                not clean_sentence.startswith('©') and
                not clean_sentence.startswith('Privacy')):
                natural_sentences.append(clean_sentence)
    
    return natural_sentences

def analyze_writing_patterns(sentences):
    '''Analyze writing style and patterns'''
    if not sentences:
        return {
            'sentence_structure': ['declarative'],
            'tone': ['professional', 'helpful'],
            'common_starters': ['We', 'Our', 'Get', 'Learn'],
            'avg_sentence_length': 12
        }
    
    starters = []
    sentence_lengths = []
    
    for sentence in sentences:
        words = sentence.split()
        if words:
            starters.append(words[0])
        sentence_lengths.append(len(words))
    
    # Analyze tone based on keywords
    all_text = ' '.join(sentences).lower()
    tone_indicators = {
        'professional': ['expert', 'professional', 'qualified', 'certified'],
        'helpful': ['help', 'support', 'assistance', 'guidance'],
        'confidential': ['private', 'confidential', 'secure'],
        'success_oriented': ['success', 'achieve', 'pass', 'excel']
    }
    
    detected_tones = []
    for tone, keywords in tone_indicators.items():
        if any(keyword in all_text for keyword in keywords):
            detected_tones.append(tone)
    
    if not detected_tones:
        detected_tones = ['professional', 'helpful']
    
    return {
        'sentence_structure': ['declarative', 'benefit_focused'],
        'tone': detected_tones,
        'common_starters': Counter(starters).most_common(8),
        'avg_sentence_length': sum(sentence_lengths) / len(sentence_lengths) if sentence_lengths else 12
    }

def extract_quality_links(soup, domain):
    '''Extract meaningful internal links'''
    quality_links = []
    seen_urls = set()
    
    links = soup.find_all('a', href=True)
    for link in links:
        href = link.get('href', '')
        link_text = clean_text(link.get_text())
        
        # Skip if no meaningful text or too short
        if len(link_text) < 5 or len(link_text) > 50:
            continue
        
        # Skip navigation links
        if link_text.upper() in ['HOME', 'ABOUT', 'SERVICES', 'CONTACT', 'LOGIN', 'SIGN UP']:
            continue
        
        # Process URL
        if href.startswith('/'):
            full_url = f'https://{domain}{href}'
        elif domain in href:
            full_url = href
        else:
            continue
        
        # Avoid duplicates
        if full_url not in seen_urls:
            seen_urls.add(full_url)
            quality_links.append({
                'text': link_text,
                'url': full_url
            })
    
    return quality_links[:10]  # Return top 10 quality links

try:
    headers = {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
    }
    
    main_url = f'https://{domain}'
