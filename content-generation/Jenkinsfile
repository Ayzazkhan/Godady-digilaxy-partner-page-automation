                    git push origin main || echo "Push completed"
                    echo "✅ GitHub update completed"
                    '''
                }
            }
        }
    }

    post {
        always {
            dir('content-generation') {
                sh '''
                    echo "🧹 Cleaning up..."
                    rm -rf venv || true
                    echo "📁 Final files:"
                    ls -la *.json *.py 2>/dev/null | wc -l
                    echo "✅ Process completed"
                '''
            }
        }
        success {
            echo "🎉 SUCCESS! 175 SEO-optimized content pieces generated!"
            echo "🔍 Based on competitor analysis"
            echo "🚀 Ready for deployment"
        }
        failure {
            echo "❌ Pipeline failed - check logs above"
            emailext (
                subject: "FAILED: Content Generation Pipeline",
                body: "The content generation pipeline failed. Please check Jenkins logs.",
                to: "ayzazkhan82@gmail.com"
            )
        }
    }
}
