print("\\n📝 STEP 4: Analyzing Writing Patterns...")
# Analyze writing style from collected sentences
if final_sentences:
    sentence_lengths = [len(sentence.split()) for sentence in final_sentences]
    avg_sentence_length = sum(sentence_lengths) / len(sentence_lengths)
    
    # Extract sentence starters
    starters = []
    for sentence in final_sentences:
        words = sentence.split()
        if words:
            starters.append(words[0])
    
    common_starters = [word for word, count in Counter(starters).most_common(10)]
else:
    avg_sentence_length = 12
    common_starters = ["Get", "Learn", "Discover", "Find", "Achieve"]

# Prepare final analysis
analysis_data = {
    "competitor_intelligence": {
        "competitors_analyzed": len(competitor_urls),
