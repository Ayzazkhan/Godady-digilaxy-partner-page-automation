except Exception as e:
    domain = "hesiexamtaker.com"
    niche = "hesi exam help"
    keywords = ["HESI exam", "nursing test", "medical exam"]

print(f"🎯 Target: {domain}")
print(f"📊 Niche: {niche}")
print(f"🔑 Keywords: {len(keywords)}")

def google_search_safe(query, num=5):
    """Safe Google search with error handling"""
    try:
        url = f"https://www.google.com/search?q={quote_plus(query)}&num={num}"
        headers = {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36",
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8",
            "Accept-Language": "en-US,en;q=0.5",
            "Accept-Encoding": "gzip, deflate",
            "Connection": "keep-alive",
        }
        response = requests.get(url, headers=headers, timeout=20)
        soup = BeautifulSoup(response.content, "html.parser")
        urls = []
        
        for link in soup.find_all("a", href=True):
            href = link.get("href", "")
            if "/url?q=" in href and "google.com" not in href:
                try:
                    clean_url = href.split("/url?q=")[1].split("&")[0]
                    if clean_url.startswith("http") and domain not in clean_url:
                        urls.append(clean_url)
                except:
                    continue
        return list(set(urls))[:3]
    except Exception as e:
        print(f"⚠️ Search error for '{query}': {e}")
        return []

def scrape_quality_content(url):
    """Extract quality content from competitor pages"""
    try:
        headers = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"}
        response = requests.get(url, headers=headers, timeout=15)
        soup = BeautifulSoup(response.content, "html.parser")
        
        # Remove unwanted elements
        for tag in soup(["script", "style", "nav", "footer", "header"]):
            tag.decompose()
        
        text_parts = []
        
        # Extract title
        if soup.title:
            title_text = soup.title.get_text().strip()
            if len(title_text) > 10:
                text_parts.append(title_text)
        
        # Extract meta description
        meta_desc = soup.find("meta", attrs={"name": "description"})
        if meta_desc and meta_desc.get("content"):
            desc_text = meta_desc.get("content").strip()
            if len(desc_text) > 20:
                text_parts.append(desc_text)
        
        # Extract headings and paragraphs
        for tag in ["h1", "h2", "h3", "p"]:
            elements = soup.find_all(tag)
            for element in elements:
                text = element.get_text().strip()
                # Quality filters
                if (20 <= len(text) <= 300 and 
                    not any(word in text.upper() for word in ["PRIVACY", "TERMS", "COOKIE", "COPYRIGHT"]) and
                    not text.startswith("©")):
                    text_parts.append(text)
        
        return " ".join(text_parts)
    except Exception as e:
        print(f"⚠️ Scraping error for {url}: {e}")
        return ""

def extract_seo_keywords(text, min_length=3):
    """Extract SEO-friendly keywords and phrases"""
    try:
        stop_words = {
            "the", "and", "for", "with", "this", "that", "are", "from", 
            "have", "has", "had", "was", "were", "will", "would", "could",
            "should", "about", "when", "where", "how", "why", "which"
        }
        
        # Extract words
        words = re.findall(r"\\b[a-zA-Z]{3,}\\b", text.lower())
        
        # Extract 2-3 word phrases
        phrases = []
        for i in range(len(words) - 2):
            phrase_2 = " ".join(words[i:i+2])
            phrase_3 = " ".join(words[i:i+3])
            
            # Filter out phrases with stop words
            if not any(sw in phrase_2.split() for sw in stop_words):
                phrases.append(phrase_2)
            if not any(sw in phrase_3.split() for sw in stop_words):
                phrases.append(phrase_3)
        
        # Count frequency and filter
        freq = Counter(phrases)
        filtered_phrases = [
            phrase for phrase, count in sorted(freq.items(), key=lambda x: x[1], reverse=True)
            if count >= 2 and len(phrase) > 5
        ]
        
        return filtered_phrases[:40]
    except Exception as e:
        print(f"⚠️ Keyword extraction error: {e}")
        return ["hesi exam help", "nursing test preparation", "medical exam assistance"]

def extract_anchor_texts(url):
    """Extract natural anchor texts from competitor sites"""
    try:
        headers = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"}
        response = requests.get(url, headers=headers, timeout=10)
        soup = BeautifulSoup(response.content, "html.parser")
        
        anchors = []
        for link in soup.find_all("a", href=True):
            text = link.get_text().strip()
            # Quality filters for anchor texts
            if (8 <= len(text) <= 35 and 
                not text.isupper() and
                not any(word in text.lower() for word in ["click", "here", "read more", "link"]) and
                not text.isdigit()):
                anchors.append(text)
        
        return list(set(anchors))[:15]
    except Exception as e:
        print(f"⚠️ Anchor extraction error: {e}")
        return ["Learn More", "Get Started", "View Services", "Contact Us"]

def analyze_writing_patterns(sentences):
    """Analyze writing style and patterns from competitor content"""
    if not sentences:
        return {
            "common_starters": ["Get", "Learn", "Discover", "Find", "Achieve"],
            "avg_sentence_length": 12,
            "tone": ["professional", "helpful"]
        }
    
    starters = []
    sentence_lengths = []
    
    for sentence in sentences:
        words = sentence.split()
        if words:
            starters.append(words[0])
        sentence_lengths.append(len(words))
    
    # Analyze tone
    all_text = " ".join(sentences).lower()
    tone_keywords = {
        "professional": ["expert", "professional", "qualified", "certified"],
        "helpful": ["help", "support", "assistance", "guidance"],
        "confidential": ["private", "confidential", "secure"],
        "success": ["success", "achieve", "pass", "excel"]
    }
    
    detected_tones = []
    for tone, keywords in tone_keywords.items():
        if any(keyword in all_text for keyword in keywords):
            detected_tones.append(tone)
    
    if not detected_tones:
        detected_tones = ["professional", "helpful"]
    
    return {
        "common_starters": [word for word, count in Counter(starters).most_common(8)],
        "avg_sentence_length": sum(sentence_lengths) / len(sentence_lengths),
        "tone": detected_tones
    }

print("")
print("🔍 STEP 1: Searching competitors...")
search_queries = [
    f"{niche}",
    f"best {niche}",
    f"professional {niche}",
    f"top {niche} services",
    f"expert {niche}"
]

all_competitor_urls = []
for query in search_queries:
    print(f"  Searching: '{query}'")
    urls = google_search_safe(query)
    all_competitor_urls.extend(urls)
    time.sleep(2)  # Be respectful

# Remove duplicates and limit
competitor_urls = list(set(all_competitor_urls))[:6]
print(f"✅ Found {len(competitor_urls)} competitor URLs")

print("")
print("📄 STEP 2: Analyzing competitor content...")
all_competitor_content = ""
all_anchor_texts = []

for i, url in enumerate(competitor_urls, 1):
    domain_name = urlparse(url).netloc
    print(f"  [{i}/{len(competitor_urls)}] Analyzing: {domain_name}")
    
    content = scrape_quality_content(url)
    if content:
        all_competitor_content += " " + content
    
    anchors = extract_anchor_texts(url)
    all_anchor_texts.extend(anchors)
    
    time.sleep(1)  # Be respectful

print(f"✅ Collected {len(all_competitor_content)} characters of content")
print(f"✅ Collected {len(all_anchor_texts)} anchor texts")

print("")
print("🔑 STEP 3: Extracting SEO keywords...")
seo_keywords = extract_seo_keywords(all_competitor_content)
if not seo_keywords:
    seo_keywords = [
        "hesi exam help", "nursing test prep", "medical exam support",
        "hesi a2 preparation", "nursing entrance exam", "healthcare test assistance"
    ]
print(f"✅ Extracted {len(seo_keywords)} SEO keywords")

print("")
print("📝 STEP 4: Analyzing writing patterns...")
sentences = re.split(r"[.!?]+", all_competitor_content)
clean_sentences = [s.strip() for s in sentences if 25 <= len(s.strip()) <= 150]
writing_patterns = analyze_writing_patterns(clean_sentences[:50])

print(f"✅ Analyzed {len(clean_sentences)} sentences")
print(f"✅ Detected tones: {writing_patterns['tone']}")

# Prepare final analysis
analysis_data = {
    "competitor_analysis": {
        "competitor_count": len(competitor_urls),
        "competitor_urls": competitor_urls,
        "content_volume": len(all_competitor_content)
    },
    "seo_data": {
        "keywords": seo_keywords,
        "anchor_texts": list(set(all_anchor_texts))[:25],
        "keyword_density": len(seo_keywords)
    },
    "content_patterns": {
        "sample_sentences": clean_sentences[:20],
        "writing_style": writing_patterns,
        "avg_content_length": writing_patterns["avg_sentence_length"]
    },
    "generation_parameters": {
        "target_domain": domain,
        "niche": niche,
        "original_keywords": keywords
    }
}

# Save analysis
with open("google_analysis.json", "w") as f:
    json.dump(analysis_data, f, indent=2)

print("")
print("=" * 70)
print("🎉 COMPETITOR ANALYSIS COMPLETE")
print("=" * 70)
print(f"📊 Competitors analyzed: {len(competitor_urls)}")
print(f"🔑 SEO keywords extracted: {len(seo_keywords)}")
print(f"🔗 Natural anchor texts: {len(analysis_data['seo_data']['anchor_texts'])}")
print(f"📝 Writing samples: {len(clean_sentences)}")
print("")
print("📋 TOP 5 KEYWORDS:")
for i, kw in enumerate(seo_keywords[:5], 1):
    print(f"  {i}. {kw}")
print("")
print("💾 Results saved to: google_analysis.json")
'''

                    // Create Content Generator Script
                    writeFile file: 'content_generator.py', text: '''import json
import random
import re
from collections import defaultdict

print("=" * 70)
print("🚀 SEO CONTENT GENERATION - COMPETITOR BASED")
print("=" * 70)

# Load competitor analysis
try:
    with open("google_analysis.json", "r") as f:
        analysis = json.load(f)
    print("✅ Loaded competitor analysis data")
except Exception as e:
    print(f"❌ Error loading analysis: {e}")
    exit(1)

# Extract data from analysis
keywords = analysis["seo_data"]["keywords"]
anchor_texts = analysis["seo_data"]["anchor_texts"]
sample_sentences = analysis["content_patterns"]["sample_sentences"]
writing_style = analysis["content_patterns"]["writing_style"]
domain = analysis["generation_parameters"]["target_domain"]

print(f"🔑 Keywords available: {len(keywords)}")
print(f"🔗 Anchor texts: {len(anchor_texts)}")
print(f"📝 Sample sentences: {len(sample_sentences)}")
print(f"🎨 Writing tone: {writing_style['tone']}")

class SEOContentGenerator:
    def __init__(self, analysis_data):
        self.keywords = analysis_data["seo_data"]["keywords"]
        self.anchors = analysis_data["seo_data"]["anchor_texts"]
        self.sample_sentences = analysis_data["content_patterns"]["sample_sentences"]
        self.writing_style = analysis_data["content_patterns"]["writing_style"]
        self.domain = analysis_data["generation_parameters"]["target_domain"]
        
        # Enhanced templates based on competitor analysis
        self.templates = self._create_templates()
        
    def _create_templates(self):
        """Create dynamic templates based on writing patterns"""
        starters = self.writing_style["common_starters"]
        if not starters:
            starters = ["Get", "Learn", "Discover", "Find", "Achieve"]
        
        base_templates = [
            # Professional templates
            "{} expert {} services. <a href=\\'https://{}/{}\\'>{}</a> Professional guidance <a href=\\'https://{}/{}\\'>{}</a> for optimal results.",
            "Need professional {} assistance? <a href=\\'https://{}/{}\\'>{}</a> Our specialists provide comprehensive support <a href=\\'https://{}/{}\\'>{}</a>.",
            "Achieve success with {} support. <a href=\\'https://{}/{}\\'>{}</a> Get professional help <a href=\\'https://{}/{}\\'>{}</a> for your goals.",
            
            # Benefit-focused templates
            "Improve your {} performance with expert guidance. <a href=\\'https://{}/{}\\'>{}</a> Comprehensive assistance <a href=\\'https://{}/{}\\'>{}</a> available.",
            "Get reliable {} solutions from experienced professionals. <a href=\\'https://{}/{}\\'>{}</a> Personalized support <a href=\\'https://{}/{}\\'>{}</a>.",
            
            # Problem-solution templates
            "Struggling with {}? <a href=\\'https://{}/{}\\'>{}</a> Our team provides effective solutions <a href=\\'https://{}/{}\\'>{}</a> for success."
        ]
        
        return base_templates
    
    def create_slug(self, text):
        """Create URL-friendly slugs"""
        slug = text.lower().replace(" ", "-")
        slug = re.sub(r"[^a-z0-9-]", "", slug)
        return slug[:25]
    
    def generate_content_piece(self):
        """Generate one SEO-optimized content piece"""
        # Select keyword and anchors
        keyword = random.choice(self.keywords)
        available_anchors = [a for a in self.anchors if len(a) > 5]
        
        if len(available_anchors) >= 2:
            anchor1 = random.choice(available_anchors)
            anchor2 = random.choice([a for a in available_anchors if a != anchor1])
        else:
            anchor1 = "Learn More"
            anchor2 = "Get Started"
        
        # Create slugs for URLs
        slug1 = self.create_slug(keyword)
        slug2 = self.create_slug(random.choice(self.keywords))
        
        # Select and format template
        template = random.choice(self.templates)
        
        # Choose appropriate starter
        starters = self.writing_style["common_starters"]
        starter = random.choice(starters) if starters else random.choice(["Get", "Learn", "Discover"])
        
        # Format the content
        content = template.format(
            starter, keyword, self.domain, slug1, anchor1,
            self.domain, slug2, anchor2
        )
        
        # Ensure natural flow and proper length
        sentences = content.split(". ")
        if len(sentences) > 2:
            content = ". ".join(sentences[:2]) + "."
        
        # Adjust word count
        words = content.split()
        if len(words) > 45:
            content = " ".join(words[:40]) + "."
        elif len(words) < 25:
            # Add more context
            extensions = [
                "Contact us for professional assistance.",
                "Get the support you need to succeed.",
                "Our experts are ready to help you."
            ]
            content += " " + random.choice(extensions)
        
        return content, keyword, [anchor1, anchor2]
    
    def generate_batch(self, count=175):
        """Generate multiple content pieces"""
        print(f"\\n🎯 Generating {count} SEO-optimized content pieces...")
        
        generated_data = []
        keyword_usage = defaultdict(int)
        max_uses = max(3, count // len(self.keywords))
        
        for i in range(count):
            # Ensure fair keyword distribution
            available_keywords = [k for k in self.keywords if keyword_usage[k] < max_uses]
            if not available_keywords:
                available_keywords = self.keywords
            
            # Temporarily override for this piece
            original_keywords = self.keywords
            self.keywords = available_keywords
            
            content, keyword, anchors = self.generate_content_piece()
            keyword_usage[keyword] += 1
            
            # Restore original keywords
            self.keywords = original_keywords
            
            word_count = len(content.split())
            links_count = content.count("<a href")
            
            generated_data.append({
                "id": i + 1,
                "keyword": keyword,
                "content": content,
                "word_count": word_count,
                "links_count": links_count,
                "anchor_texts": anchors,
                "seo_score": "high" if links_count >= 2 and 25 <= word_count <= 50 else "medium"
            })
            
            if (i + 1) % 25 == 0:
                print(f"  ✅ Generated {i + 1}/{count}")
        
        return generated_data

# Initialize generator
generator = SEOContentGenerator(analysis)

# Generate content
content_data = generator.generate_batch(175)

# Save results
with open("seo_expert_content.json", "w") as f:
    json.dump(content_data, f, indent=2)

print("")
print("=" * 70)
print("🎉 CONTENT GENERATION COMPLETE")
print("=" * 70)

# Statistics
total_pieces = len(content_data)
total_words = sum(item["word_count"] for item in content_data)
total_links = sum(item["links_count"] for item in content_data)
pieces_with_links = sum(1 for item in content_data if item["links_count"] >= 2)

print(f"📊 GENERATION STATISTICS:")
print(f"   • Total pieces: {total_pieces}")
print(f"   • Average words: {total_words/total_pieces:.1f}")
print(f"   • Total links: {total_links}")
print(f"   • Pieces with 2+ links: {pieces_with_links}/{total_pieces}")
print(f"   • SEO score: High - {sum(1 for item in content_data if item['seo_score'] == 'high')} pieces")

print("")
print("📋 SAMPLE CONTENT PIECES:")
print("=" * 50)
for i in range(2):
    sample = content_data[i]
    print(f"\\n--- Sample {i+1} ---")
    print(f"Keyword: {sample['keyword']}")
    print(f"Content: {sample['content']}")
    print(f"Words: {sample['word_count']} | Links: {sample['links_count']} | SEO: {sample['seo_score']}")
    print("")

print("💾 Results saved to: seo_expert_content.json")
'''

                    echo "✅ Python scripts created successfully"
                }
            }
