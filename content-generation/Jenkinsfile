    all_seo_data["anchor_texts"].extend(anchors)
    
    all_seo_data["content_analysis"].append({
        "domain": domain_name,
        "content_volume": seo_analysis["content_volume"],
        "headings": seo_analysis["heading_structure"][:5]
    })
    
    time.sleep(1)  # Be respectful

print("\\n🔧 STEP 3: Processing Collected Data...")
# Process and deduplicate data
final_keywords = list(set(all_seo_data["keywords"]))[:60]
