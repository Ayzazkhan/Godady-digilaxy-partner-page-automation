                    cat > content_generator.py << 'EOF'
import json
import os
import requests
import random
import time
import re
import sys
from datetime import datetime

print("=" * 70)
print("🚀 HUGGING FACE CONTENT GENERATOR - NEW MODELS EDITION")
print("=" * 70)

# Load configuration
try:
    with open("content.json", "r") as f:
        config = json.load(f)
    print("✅ content.json loaded successfully")
except Exception as e:
    print(f"❌ ERROR reading content.json: {e}")
    sys.exit(1)

base_content = config.get("base_content", "")
domain = config.get("target_domain", "hesiexamtaker.com")
keywords = config.get("keywords", [])
tone = config.get("tone", "professional and educational")

print(f"📊 CONFIGURATION:")
print(f"  - Domain: {domain}")
print(f"  - Keywords: {len(keywords)}")
print(f"  - Base Content Length: {len(base_content)} characters")

if not base_content:
    print("❌ ERROR: base_content missing in content.json")
    sys.exit(1)

# Extract links from base content
links = re.findall(r"<a href='https://[^']+'[^>]*>[^<]+</a>", base_content)
print(f"🔗 Found {len(links)} links in base content")

if len(links) < 2:
    print("❌ ERROR: Need at least 2 links in base_content")
    sys.exit(1)

# Hugging Face API Configuration
HUGGINGFACE_API_KEY = os.environ.get("HUGGINGFACE_API_KEY")
if not HUGGINGFACE_API_KEY:
    print("❌ ERROR: HUGGINGFACE_API_KEY not found in environment!")
    sys.exit(1)

print(f"🔑 Hugging Face API Key loaded")

# NEW WORKING MODELS - Tumhare diye hue models
NEW_WORKING_MODELS = [
    "deepseek-ai/DeepSeek-OCR",           # ✅ Text generation model
    "MiniMaxAI/MiniMax-M2",               # ✅ MiniMax ka latest model
    "moonshotai/Kimi-K2-Thinking",        # ✅ Thinking capable model
    "PaddlePaddle/PaddleOCR-VL",          # ✅ Vision + Language model
    "dx8152/Qwen-Edit-2509-Multiple-angles", # ✅ Qwen editing model
    "maya-research/maya1"                 # ✅ Research model
]

headers = {
    "Authorization": f"Bearer {HUGGINGFACE_API_KEY}",
    "Content-Type": "application/json"
}

def test_specific_models():
    """Test the specific models you found"""
    print("\\n🔍 TESTING YOUR SPECIFIC MODELS...")
    
    test_prompt = "Write a short paragraph about nursing exam preparation."
    working_models = []
    
    for model in NEW_WORKING_MODELS:
        try:
            API_URL = f"https://api-inference.huggingface.co/models/{model}"
            
            # Different parameters for different model types
            if "OCR" in model or "PaddleOCR" in model:
                # OCR models might need different approach
                print(f"  🔄 Skipping OCR model: {model} (not suitable for text generation)")
                continue
                
            payload = {
                "inputs": test_prompt,
                "parameters": {
                    "max_length": 100,
                    "temperature": 0.7,
                    "do_sample": True,
                    "return_full_text": False
                }
            }
            
            print(f"  Testing: {model}")
            response = requests.post(API_URL, headers=headers, json=payload, timeout=25)
            
            if response.status_code == 200:
                working_models.append(model)
                print(f"    ✅ WORKING - Status: {response.status_code}")
                # Print sample response
                try:
                    result = response.json()
                    if isinstance(result, list) and len(result) > 0:
                        sample_text = result[0].get('generated_text', '')[:50]
                        print(f"    Sample: {sample_text}...")
                except:
                    pass
                    
            elif response.status_code == 503:
                working_models.append(model)
                print(f"    ⚠️  LOADING - Model is loading: {response.status_code}")
            elif response.status_code == 400:
                print(f"    ℹ️  MODEL EXISTS but needs different input: {response.status_code}")
                working_models.append(model)  # Still consider it available
            else:
                print(f"    ❌ FAILED - Status: {response.status_code}")
                
        except Exception as e:
            print(f"    ❌ ERROR - {str(e)}")
    
    return working_models

# Test the specific models
available_models = test_specific_models()

if not available_models:
    print("\\n❌ No specific models are working for text generation!")
    print("💡 Trying alternative text generation models...")
    
    # Fallback to general text models
    FALLBACK_MODELS = [
        "gpt2",
        "distilgpt2", 
        "EleutherAI/gpt-neo-125M",
        "microsoft/DialoGPT-medium"
    ]
    
    for model in FALLBACK_MODELS:
        try:
            API_URL = f"https://api-inference.huggingface.co/models/{model}"
            payload = {"inputs": "Test", "parameters": {"max_length": 20}}
            response = requests.post(API_URL, headers=headers, json=payload, timeout=15)
            if response.status_code in [200, 503]:
                available_models.append(model)
                print(f"  ✅ Fallback model working: {model}")
                break
        except:
            continue

if not available_models:
    print("\\n⚠️  No models available. Using enhanced fallback system.")
    available_models = ["fallback"]

print(f"\\n🎉 AVAILABLE MODELS: {len(available_models)}")
for model in available_models:
    print(f"   ✅ {model}")

def generate_with_model(keyword, model_name):
    """Generate content using specific model"""
    
    if model_name == "fallback":
        return None
    
    # Optimized prompt for different model types
    if "MiniMax" in model_name or "Kimi" in model_name or "Qwen" in model_name:
        prompt = f"""
As a professional content writer, create a short SEO-friendly paragraph (45-65 words) about {keyword} for nursing students.

Key points to include:
- Nursing exam preparation and success
- Professional guidance and support  
- These resources: {links[0]} and {links[1]}

Tone: Professional, helpful, educational
"""
    else:
        prompt = f"""
Write a professional SEO paragraph about {keyword} for nursing exam preparation.
Include natural references to: {links[0]} and {links[1]}
Keep it between 40-60 words. Focus on educational value.
"""
    
    try:
        API_URL = f"https://api-inference.huggingface.co/models/{model_name}"
        
        payload = {
            "inputs": prompt,
            "parameters": {
                "max_length": 150,
                "temperature": 0.8,
                "do_sample": True,
                "return_full_text": False,
                "top_p": 0.9,
                "repetition_penalty": 1.1
            }
        }
        
        response = requests.post(API_URL, headers=headers, json=payload, timeout=35)
        
        if response.status_code == 200:
            result = response.json()
            
            # Handle different response formats
            if isinstance(result, list) and len(result) > 0:
                content = ""
                if 'generated_text' in result[0]:
                    content = result[0]['generated_text'].strip()
                elif 'text' in result[0]:
                    content = result[0]['text'].strip()
                else:
                    # Try to get any text from response
                    content = str(result[0]).strip()
                
                if content and len(content) > 30:
                    # Clean up content
                    content = re.sub(r'[\\n\\t]+', ' ', content)
                    content = ' '.join(content.split())  # Remove extra spaces
                    return content
                    
        elif response.status_code == 503:
            print(f"    ⏳ Model {model_name} is loading, waiting 15 seconds...")
            time.sleep(15)
            return generate_with_model(keyword, model_name)  # Retry
            
    except Exception as e:
        print(f"    ❌ Model {model_name} error: {str(e)}")
    
    return None

def get_enhanced_fallback(keyword):
    """High-quality fallback content with variations"""
    
    # Different content angles for diversity
    angles = [
        # Problem-Solution angle
        f"Struggling with {keyword}? Get comprehensive nursing exam support and expert guidance. {links[0]} Our specialized {keyword} program offers proven strategies and personalized assistance. {links[1]} Achieve your healthcare career goals with confidence and professional backing.",
        
        # Benefits-focused angle  
        f"Excel in your {keyword} with our dedicated preparation platform and premium resources. {links[0]} Access expert strategies, proven techniques, and personalized {keyword} guidance. {links[1]} Join thousands of successful nursing students in achieving exam excellence.",
        
        # Authority angle
        f"Master {keyword} with professional nursing exam guidance and comprehensive support system. {links[0]} Our expert team provides specialized {keyword} assistance with evidence-based preparation methods. {links[1]} Transform your test performance and build healthcare career confidence.",
        
        # Results angle
        f"Achieve outstanding {keyword} results with our professional support framework. {links[0]} Access specialized nursing exam resources, proven methodologies, and expert guidance. {links[1]} Your healthcare career success begins with proper preparation and dedicated support."
    ]
    
    selected = random.choice(angles)
    
    # Add some randomization
    variations = {
        "comprehensive": ["thorough", "complete", "extensive"],
        "expert": ["professional", "specialized", "experienced"],
        "proven": ["tested", "established", "verified"],
        "achieve": ["attain", "accomplish", "reach"]
    }
    
    for word, alternatives in variations.items():
        if word in selected:
            selected = selected.replace(word, random.choice(alternatives), 1)
    
    return selected

# MAIN GENERATION PROCESS
TOTAL_CONTENTS = 50
generated_data = []

print(f"\\n🎯 GENERATING {TOTAL_CONTENTS} CONTENT PIECES...")
print("=" * 50)

success_count = 0
model_success_count = 0
fallback_count = 0

for i in range(TOTAL_CONTENTS):
    try:
        keyword = random.choice(keywords)
        print(f"\\n📝 {i+1}/{TOTAL_CONTENTS} - Keyword: {keyword}")
        
        content = None
        used_model = "fallback"
        
        # Try available models
        for model in available_models:
            if model != "fallback":
                content = generate_with_model(keyword, model)
                if content:
                    used_model = model
                    model_success_count += 1
                    print(f"  ✅ Generated with: {model}")
                    break
        
        # If models fail, use enhanced fallback
        if not content:
            content = get_enhanced_fallback(keyword)
            fallback_count += 1
            print(f"  🔄 Using enhanced fallback")
        
        # Ensure proper link inclusion
        final_content = content
        links_count = 0
        
        # Check and add links if missing
        for link in links:
            if link in final_content:
                links_count += 1
            else:
                # Add link naturally
                sentences = [s.strip() for s in final_content.split('.') if s.strip()]
                if len(sentences) > 1:
                    insert_pos = random.randint(1, len(sentences)-1)
                    link_phrase = f"Access comprehensive resources at {link}" if "Access" not in link else link
                    sentences.insert(insert_pos, link_phrase)
                    final_content = '. '.join(sentences)
                    links_count += 1
        
        # Final link count adjustment
        if links_count < 2:
            missing_links = [link for link in links if link not in final_content]
            for missing_link in missing_links[:2-links_count]:
                final_content += f" {missing_link}"
            links_count = 2
        
        generated_data.append({
            "id": i + 1,
            "keyword": keyword,
            "content": final_content,
            "word_count": len(final_content.split()),
            "links_count": links_count,
            "model_used": used_model,
            "timestamp": datetime.now().isoformat(),
            "content_hash": hash(final_content) % 1000000  # Simple content hash
        })
        
        success_count += 1
        print(f"  ✅ Completed - Links: {links_count}, Words: {len(final_content.split())}")
        
        # Rate limiting
        time.sleep(2)
        
    except Exception as e:
        print(f"❌ Error in item {i+1}: {str(e)}")
        continue

# SAVE RESULTS
print("\\n💾 SAVING RESULTS...")
try:
    output_file = "new_models_content.json"
    with open(output_file, "w", encoding="utf-8") as f:
        json.dump(generated_data, f, indent=2, ensure_ascii=False)
    
    print(f"✅ Results saved to {output_file}")
    
except Exception as e:
    print(f"❌ Error saving results: {e}")
    sys.exit(1)

