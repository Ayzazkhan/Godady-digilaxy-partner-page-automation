pipeline {
    agent any

    stages {
        stage('Setup Content Generation Environment') {
            steps {
                dir('content-generation') {
                    sh '''
                    echo "🚀 Installing Content Generation Libraries..."
                    python3 -m venv venv || python -m venv venv
                    . venv/bin/activate
                    pip install --upgrade pip
                    
                    # Core content generation libraries
                    pip install transformers torch
                    pip install sentencepiece protobuf
                    pip install huggingface_hub
                    pip install gpt4all
                    pip install simpletransformers
                    
                    echo "✅ Content Generation Libraries Installed"
                    '''
                }
            }
        }

        stage('Create Content Generation Scripts') {
            steps {
                dir('content-generation') {
                    writeFile file: 'content_generation_lib.py', text: '''import json
import random
import re
from collections import defaultdict
import torch
from transformers import pipeline, AutoTokenizer, AutoModelForCausalLM
from huggingface_hub import InferenceClient

print("=" * 80)
print("🚀 PYTHON CONTENT GENERATION LIBRARIES")
print("=" * 80)

class ContentGenerator:
    def __init__(self):
        print("🛠️ Initializing Content Generation Libraries...")
        self.generators = {}
        self.setup_generators()
    
    def setup_generators(self):
        """Setup different content generation models"""
        try:
            # 1. GPT-2 (Most reliable free model)
            self.generators['gpt2'] = pipeline(
                "text-generation",
                model="gpt2",
                tokenizer="gpt2",
                torch_dtype=torch.float16,
                device_map="auto"
            )
            print("  ✅ GPT-2 loaded")
        except Exception as e:
            print(f"  ⚠️ GPT-2 failed: {e}")
        
        try:
            # 2. DistilGPT2 (Faster alternative)
            self.generators['distilgpt2'] = pipeline(
                "text-generation",
                model="distilgpt2"
            )
            print("  ✅ DistilGPT2 loaded")
        except Exception as e:
            print(f"  ⚠️ DistilGPT2 failed: {e}")
        
        try:
            # 3. Hugging Face Inference API (No local model needed)
            self.generators['hf_api'] = InferenceClient()
            print("  ✅ Hugging Face API ready")
        except Exception as e:
            print(f"  ⚠️ HF API failed: {e}")
    
    def generate_with_gpt2(self, prompt, max_length=60):
        """Generate content using GPT-2"""
        try:
            result = self.generators['gpt2'](
                prompt,
                max_length=max_length,
                num_return_sequences=1,
                temperature=0.8,
                do_sample=True,
                pad_token_id=50256
            )
            return result[0]['generated_text'].replace(prompt, '').strip()
        except:
            return None
    
    def generate_with_distilgpt2(self, prompt, max_length=60):
        """Generate content using DistilGPT2"""
        try:
            result = self.generators['distilgpt2'](
                prompt,
                max_length=max_length,
                num_return_sequences=1,
                temperature=0.8,
                do_sample=True
            )
            return result[0]['generated_text'].replace(prompt, '').strip()
        except:
            return None
    
    def generate_with_hf_api(self, prompt, max_length=60):
        """Generate content using Hugging Face API"""
        try:
            result = self.generators['hf_api'].text_generation(
                prompt,
                max_new_tokens=max_length,
                temperature=0.8
            )
            return result.replace(prompt, '').strip()
        except:
            return None
    
    def generate_content(self, prompt, max_length=60):
        """Generate content using available models"""
        # Try GPT-2 first
        content = self.generate_with_gpt2(prompt, max_length)
        if content:
            return content
        
        # Try DistilGPT2
        content = self.generate_with_distilgpt2(prompt, max_length)
        if content:
            return content
        
        # Try HF API
        content = self.generate_with_hf_api(prompt, max_length)
        if content:
            return content
        
        # Fallback to template-based generation
        return self.fallback_generation(prompt)
    
    def fallback_generation(self, prompt):
        """Template-based fallback generation"""
        templates = [
            "Professional academic assistance for students seeking quality results.",
            "Expert guidance and comprehensive support for academic success.",
            "Reliable services providing tailored solutions for educational needs.",
            "Quality academic help from experienced professionals in the field.",
            "Comprehensive support system for students aiming for excellence."
        ]
        return random.choice(templates)

# Load analysis data
print("📂 Loading analysis data...")
try:
    with open("advanced_analysis.json", "r") as f:
        analysis = json.load(f)
    
    keywords = analysis.get("seo_optimization", {}).get("keywords", [])
    anchors = analysis.get("seo_optimization", {}).get("anchor_texts", [])
    domain = analysis.get("generation_parameters", {}).get("target_domain", "economicsassignmenthelp.co.uk")
    
    if not keywords:
        keywords = [
            "economics assignment help", "economics homework help",
            "economics paper writing", "economic research assistance"
        ]
    
    if not anchors:
        anchors = ["Learn More", "Get Started", "View Services", "Contact Us"]
        
except Exception as e:
    print(f"❌ Error: {e}")
    keywords = ["economics assignment help", "academic writing services"]
    anchors = ["Learn More", "Get Started"]
    domain = "economicsassignmenthelp.co.uk"

print(f"📊 Generation Parameters:")
print(f"   • Keywords: {len(keywords)}")
print(f"   • Anchors: {len(anchors)}")

class AdvancedContentGenerator:
    def __init__(self, keywords, anchors, domain):
        self.keywords = keywords
        self.anchors = anchors
        self.domain = domain
        self.content_gen = ContentGenerator()
        
        # Content templates with placeholders for AI generation
        self.prompts = {
            "professional": "Write a professional 2-sentence paragraph about {keyword} services:",
            "benefit": "Create benefit-focused content for {keyword} assistance:",
            "academic": "Write academic-focused content about {keyword} support:",
            "service": "Describe service offerings for {keyword} in 2 sentences:"
        }
    
    def create_slug(self, text):
        """Create SEO-friendly slugs"""
        slug = text.lower().replace(' ', '-')
        slug = re.sub(r'[^a-z0-9-]', '', slug)
        return slug[:30]
    
    def generate_ai_content(self, keyword, prompt_type):
        """Generate AI-powered content"""
        prompt_template = self.prompts.get(prompt_type, self.prompts["professional"])
        prompt = prompt_template.format(keyword=keyword)
        
        # Generate content using AI
        ai_content = self.content_gen.generate_content(prompt, max_length=80)
        
        # Clean and format
        ai_content = re.sub(r'[^\\w\\s.,!?-]', '', ai_content)
        sentences = ai_content.split('.')
        if len(sentences) > 2:
            ai_content = '. '.join(sentences[:2]) + '.'
        
        return ai_content.strip()
    
    def generate_content_piece(self):
        """Generate one complete content piece"""
        keyword = random.choice(self.keywords)
        prompt_type = random.choice(list(self.prompts.keys()))
        
        # Select anchors
        available_anchors = [a for a in self.anchors if 5 <= len(a) <= 35]
        if len(available_anchors) >= 2:
            anchor1 = random.choice(available_anchors)
            anchor2 = random.choice([a for a in available_anchors if a != anchor1])
        else:
            anchor1, anchor2 = "Learn More", "Get Started"
        
        # Generate AI content
        ai_content = self.generate_ai_content(keyword, prompt_type)
        
        # Create slugs
        slug1 = self.create_slug(keyword)
        slug2 = self.create_slug(random.choice(self.keywords))
        
        # Build final content with links
        content = f"{ai_content} <a href='https://{self.domain}/{slug1}'>{anchor1}</a>"
        
        # Add second link
        if random.random() < 0.7:
            content += f" <a href='https://{self.domain}/{slug2}'>{anchor2}</a>"
        
        return content, keyword, [anchor1, anchor2], prompt_type
    
    def generate_batch(self, count=175):
        """Generate batch of content pieces"""
        print(f"\\n🎯 GENERATING {count} CONTENT PIECES...")
        
        if not self.keywords:
            return []
        
        try:
            max_uses = max(2, count // len(self.keywords))
        except:
            max_uses = 10
        
        generated_data = []
        keyword_usage = defaultdict(int)
        
        for i in range(count):
            try:
                available_keywords = [k for k in self.keywords if keyword_usage[k] < max_uses]
                if not available_keywords:
                    available_keywords = self.keywords
                
                keyword = random.choice(available_keywords)
                keyword_usage[keyword] += 1
                
                content, keyword, anchors, prompt_type = self.generate_content_piece()
                
                word_count = len(content.split())
                links_count = content.count('<a href')
                
                # Quality scoring
                quality_score = self.calculate_quality(content, word_count, links_count)
                
                generated_data.append({
                    'id': i + 1,
                    'keyword': keyword,
                    'content': content,
                    'word_count': word_count,
                    'links_count': links_count,
                    'anchor_texts': anchors,
                    'prompt_type': prompt_type,
                    'quality_score': quality_score,
                    'ai_generated': True
                })
                
                if (i + 1) % 25 == 0:
                    print(f"  ✅ {i + 1}/{count} - {keyword}")
                    
            except Exception as e:
                print(f"  ⚠️ Error {i+1}: {e}")
                continue
        
        return generated_data
    
    def calculate_quality(self, content, word_count, links_count):
        """Calculate content quality score"""
        score = 0
        
        if 25 <= word_count <= 60:
            score += 2
        elif 20 <= word_count <= 70:
            score += 1
        
        if links_count >= 2:
            score += 2
        elif links_count >= 1:
            score += 1
        
        if any(term in content.lower() for term in ['professional', 'expert', 'help']):
            score += 1
        
        return "excellent" if score >= 5 else "good" if score >= 3 else "satisfactory"

# Initialize and generate content
print("\\n🔄 Initializing Content Generator...")
generator = AdvancedContentGenerator(keywords, anchors, domain)

print("\\n🚀 STARTING CONTENT GENERATION...")
content_data = generator.generate_batch(175)

# Save results
output_file = "python_lib_content.json"
with open(output_file, "w") as f:
    json.dump(content_data, f, indent=2)

print("\\n" + "=" * 80)
print("🎉 CONTENT GENERATION COMPLETE")
print("=" * 80)

# Statistics
total = len(content_data)
if total > 0:
    words = sum(item['word_count'] for item in content_data)
    links = sum(item['links_count'] for item in content_data)
    
    quality_dist = defaultdict(int)
    for item in content_data:
        quality_dist[item['quality_score']] += 1
    
    print(f"📊 RESULTS:")
    print(f"   • Total Pieces: {total}")
    print(f"   • Average Words: {words/total:.1f}")
    print(f"   • Total Links: {links}")
    print(f"   • AI Generated: {sum(1 for item in content_data if item['ai_generated'])}")
    
    print(f"\\n🏆 QUALITY:")
    for quality, count in quality_dist.items():
        print(f"   • {quality.title()}: {count} pieces")
    
    print(f"\\n📋 SAMPLE:")
    if content_data:
        sample = content_data[0]
        print(f"   Keyword: {sample['keyword']}")
        print(f"   Content: {sample['content'][:100]}...")
    
    print(f"\\n💾 Saved to: {output_file}")
else:
    print("❌ No content generated")
'''
                }
            }
        }

        stage('Generate Content with Python Libraries') {
