import json
import requests
from bs4 import BeautifulSoup
import re
from collections import Counter

print('=' * 60)
print('🔍 SMART CONTENT EXTRACTION')
print('=' * 60)

# Load config
try:
    with open('content.json', 'r') as f:
        config = json.load(f)
    domain = config.get('target_domain', 'hesiexamtaker.com')
    print(f'🌐 Analyzing: {domain}')
except Exception as e:
    domain = 'hesiexamtaker.com'
    print(f'⚠️ Using default domain: {domain}')

def clean_text(text):
    '''Clean and normalize text'''
    text = re.sub(r'\\s+', ' ', text)
    text = re.sub(r'\\b(HOME|ABOUT|SERVICES|CONTACT|MENU|LOGIN|SIGNUP)\\b', '', text, flags=re.IGNORECASE)
    return text.strip()

def extract_quality_content(soup):
    '''Extract only quality content paragraphs'''
    quality_content = []
    
    # First try: Main content areas
    content_areas = ['main', 'article', '.content', '.post-content', '.entry-content', '.text-block']
    
    for area in content_areas:
        elements = soup.select(area)
        for element in elements:
            paragraphs = element.find_all('p')
            for p in paragraphs:
                text = clean_text(p.get_text())
                if 40 <= len(text) <= 400:
                    quality_content.append(text)
    
    # Second try: All paragraphs but filtered
    if not quality_content:
        all_paragraphs = soup.find_all('p')
        for p in all_paragraphs:
            text = clean_text(p.get_text())
            # Filter out navigation and footer content
            if (40 <= len(text) <= 400 and 
                not any(word in text.upper() for word in ['PRIVACY', 'TERMS', 'COOKIE', 'COPYRIGHT'])):
                quality_content.append(text)
    
    return quality_content

def extract_natural_sentences(quality_content):
    '''Extract complete, natural sentences'''
    natural_sentences = []
    
    for content in quality_content:
        sentences = re.split(r'[.!?]+', content)
        for sentence in sentences:
            clean_sentence = clean_text(sentence)
            if (25 <= len(clean_sentence) <= 150 and 
                len(clean_sentence.split()) >= 6 and
                not any(word in clean_sentence.upper() for word in ['HOME', 'ABOUT', 'SERVICES', 'CONTACT'])):
                natural_sentences.append(clean_sentence)
    
    return natural_sentences

def extract_quality_links(soup, domain):
    '''Extract meaningful internal links'''
    quality_links = []
    seen_urls = set()
    
    links = soup.find_all('a', href=True)
    for link in links:
        href = link.get('href', '')
        link_text = clean_text(link.get_text())
        
        # Skip if no meaningful text
        if len(link_text) < 5 or len(link_text) > 40:
            continue
        
        # Skip navigation links
        if link_text.upper() in ['HOME', 'ABOUT', 'SERVICES', 'CONTACT', 'LOGIN', 'SIGN UP', 'MENU']:
            continue
        
        # Process URL
        if href.startswith('/'):
            full_url = f'https://{domain}{href}'
        elif domain in href:
            full_url = href
        else:
            continue
        
        # Avoid duplicates
        if full_url not in seen_urls:
            seen_urls.add(full_url)
            quality_links.append({
                'text': link_text,
                'url': full_url
            })
    
    return quality_links[:8]

try:
    headers = {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
    }
    
    main_url = f'https://{domain}'
    print(f'📄 Analyzing: {main_url}')
    
    response = requests.get(main_url, headers=headers, timeout=20)
    soup = BeautifulSoup(response.content, 'html.parser')
    
