import json
import random
import re
from collections import defaultdict

print('=' * 60)
print('🚀 NATURAL CONTENT GENERATION')
print('=' * 60)

# Load analysis data
try:
    with open('deep_analysis.json', 'r') as f:
        analysis = json.load(f)
    print('✅ Loaded deep analysis data')
except Exception as e:
    print(f'❌ Could not load analysis: {e}')
    analysis = {
        'content_patterns': {
            'natural_phrases': [
                'Get professional help with your exam preparation',
                'Our team provides comprehensive support',
                'Achieve better scores with proven strategies'
            ],
            'key_phrases': ['exam', 'preparation', 'success', 'help']
        },
        'site_structure': {
            'internal_links': [
                {'text': 'Our Services', 'url': 'https://example.com/services'},
                {'text': 'Get Help', 'url': 'https://example.com/help'}
            ],
            'writing_style': 'professional'
        }
    }

# Load content config
try:
    with open('content.json', 'r') as f:
        config = json.load(f)
    keywords = config.get('keywords', [])
    target_domain = config.get('target_domain', 'hesiexamtaker.com')
    print(f'✅ Loaded {len(keywords)} keywords')
except Exception as e:
    print(f'❌ Could not load content.json: {e}')
    keywords = ['HESI exam', 'nursing test', 'medical exam preparation', 'exam help', 'test preparation']
    target_domain = 'hesiexamtaker.com'

print(f'📊 Generation Parameters:')
print(f'   - Keywords: {len(keywords)}')
print(f'   - Target Domain: {target_domain}')

class NaturalContentGenerator:
    def __init__(self, analysis_data):
        self.analysis = analysis_data
        self.natural_phrases = analysis_data['content_patterns']['natural_phrases']
        self.internal_links = analysis_data['site_structure']['internal_links']
        
    def construct_natural_sentence(self, keyword):
        if self.natural_phrases:
            base_phrase = random.choice(self.natural_phrases)
            words = base_phrase.split()
            if len(words) > 4:
                replace_pos = random.randint(1, len(words)-2)
                words[replace_pos] = keyword
                adapted = ' '.join(words)
                return adapted
            else:
                return f'{base_phrase} for {keyword}'
        else:
            templates = [
                'Professional support for {} that delivers real results.',
                'When it comes to {}, our approach focuses on practical outcomes.',
                'Many students find {} challenging but our methods make it manageable.',
                'Achieve success in {} through our carefully developed approach.',
                'We provide specialized assistance for {} that really works.'
            ]
            return random.choice(templates).format(keyword)
    
    def generate_paragraph(self, keyword):
        sentences = []
        target_sentences = random.randint(2, 3)
        
        for _ in range(target_sentences):
            sentence = self.construct_natural_sentence(keyword)
            sentences.append(sentence)
        
        paragraph = ' '.join(sentences)
        
        words = paragraph.split()
        if len(words) < 30:
            extra_sentence = self.construct_natural_sentence(keyword)
            paragraph += ' ' + extra_sentence
        elif len(words) > 55:
            words = words[:50]
            paragraph = ' '.join(words)
        
        return paragraph.strip()
    
    def smart_link_integration(self, content, keyword):
        if not self.internal_links:
            return content, 0
        
        link_count = 0
        enhanced_content = content
        
        link1 = random.choice(self.internal_links)
        anchor1 = link1['text']
        url1 = link1['url']
        
        sentences = re.split(r'[.!?]+', content)
        if len(sentences) >= 2:
            target_sentence = sentences[1].strip()
            if len(target_sentence.split()) > 3:
                words = target_sentence.split()
                insert_pos = random.randint(1, len(words)-1)
                words.insert(insert_pos, f'<a href=\\"{url1}\\">{anchor1}</a>')
                sentences[1] = ' '.join(words)
                link_count += 1
                
                if len(sentences) >= 3 and random.random() < 0.4:
                    link2 = random.choice([l for l in self.internal_links if l['text'] != anchor1])
                    if link2:
                        target_sentence = sentences[-1].strip()
                        if len(target_sentence.split()) > 2:
                            words = target_sentence.split()
                            insert_pos = random.randint(0, len(words)-1)
                            words.insert(insert_pos, f'<a href=\\"{link2[\\\"url\\\"]}\\">{link2[\\\"text\\\"]}</a>')
                            sentences[-1] = ' '.join(words)
                            link_count += 1
        
        enhanced_content = '. '.join(sentences) + '.'
        return enhanced_content, link_count

generator = NaturalContentGenerator(analysis)

print('\\n🎯 GENERATING 175 NATURAL CONTENT PIECES...')
generated_data = []

keyword_usage = defaultdict(int)
max_keyword_use = max(3, len(keywords) // 50)

for i in range(175):
    available_keywords = [k for k in keywords if keyword_usage[k] < max_keyword_use]
    if not available_keywords:
        available_keywords = keywords
    
    keyword = random.choice(available_keywords)
    keyword_usage[keyword] += 1
    
    natural_content = generator.generate_paragraph(keyword)
    final_content, links_count = generator.smart_link_integration(natural_content, keyword)
    
    generated_data.append({
        'id': i + 1,
        'keyword': keyword,
        'content': final_content.strip(),
        'word_count': len(final_content.split()),
        'links_count': links_count,
        'style': analysis['site_structure']['writing_style']
    })
    
    if (i + 1) % 25 == 0:
        print(f'✅ Generated {i + 1}/175')

with open('natural_content.json', 'w') as f:
    json.dump(generated_data, f, indent=2)

print('\\n🎉 NATURAL GENERATION COMPLETE!')
print(f'📊 Final Statistics:')
print(f'   - Total pieces: {len(generated_data)}')
print(f'   - Average words: {sum(item[\\\"word_count\\\"] for item in generated_data)/len(generated_data):.1f}')
print(f'   - Total links: {sum(item[\\\"links_count\\\"] for item in generated_data)}')

print('\\n📋 SAMPLE CONTENT:')
for i in range(2):
    sample = generated_data[i]
    print(f'\\nSample {i+1}:')
    print(f'Keyword: {sample[\\\"keyword\\\"]}')
    print(f'Content: {sample[\\\"content\\\"]}')
    print(f'Words: {sample[\\\"word_count\\\"]}, Links: {sample[\\\"links_count\\\"]}')
