import json, os
from collections import Counter

print("📊 SMART CONTENT VERIFICATION REPORT")
print("=" * 50)

file_path = "smart_website_content.json"
if not os.path.exists(file_path):
    print("❌ Generated file not found!")
    exit(1)

try:
    with open(file_path, "r", encoding="utf-8") as f:
        data = json.load(f)
    
    print(f"✅ File loaded: {len(data)} content pieces")
    
    # Quality analysis
    word_counts = [item['word_count'] for item in data]
    link_counts = [item['links_count'] for item in data]
    styles = Counter([item.get('style', 'unknown') for item in data])
    
    print(f"\\n📈 QUALITY METRICS:")
    print(f"   - Average Words: {sum(word_counts)/len(word_counts):.1f}")
    print(f"   - Average Links: {sum(link_counts)/len(link_counts):.1f}")
    print(f"   - Content Styles: {dict(styles)}")
    
    # Check for proper link inclusion
    proper_links = sum(1 for item in data if item['links_count'] >= 2)
    print(f"   - Properly Linked: {proper_links}/{len(data)} ({proper_links/len(data)*100:.1f}%)")
    
    # Show content samples
    print(f"\\n📝 CONTENT SAMPLES:")
    print("=" * 40)
    for i, item in enumerate(data[:3]):
        print(f"\\n{i+1}. {item['keyword']}")
        print(f"   Style: {item.get('style', 'unknown')}")
        print(f"   Words: {item['word_count']}, Links: {item['links_count']}")
        print(f"   Preview: {item['content'][:80]}...")
        print("-" * 40)
    
    # Keyword distribution
    keyword_dist = Counter([item['keyword'] for item in data])
    print(f"\\n🎯 KEYWORD DISTRIBUTION:")
    for keyword, count in keyword_dist.most_common():
        print(f"   {keyword}: {count} times")
    
    print(f"\\n🎉 SMART CONTENT VERIFICATION PASSED!")
    
except Exception as e:
    print(f"❌ Verification failed: {e}")
    exit(1)
