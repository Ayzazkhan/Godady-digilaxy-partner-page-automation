pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Ayzazkhan/Godady-digilaxy-partner-page-automation.git',
                    credentialsId: 'github-credentials'
            }
        }

        stage('Setup') {
            steps {
                dir('content-generation') {
                    sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install requests beautifulsoup4
                    '''
                }
            }
        }

        stage('Generate Content - All in One') {
            steps {
                dir('content-generation') {
                    sh '''
                    . venv/bin/activate
                    
                    cat > generate_all.py << 'PYTHON_END'
import json
import random
import re

print("=" * 70)
print("COMPLETE SEO CONTENT GENERATION")
print("=" * 70)

# Load config
try:
    with open("content.json", "r") as f:
        config = json.load(f)
    domain = config.get("target_domain", "hesiexamtaker.com")
    print(f"Domain: {domain}")
except:
    domain = "hesiexamtaker.com"
    print("Using default domain")

# Pre-defined high-quality keywords (Google search se manually collected)
KEYWORDS = [
    "hesi exam help online",
    "nursing entrance test preparation",
    "hesi a2 exam assistance",
    "medical exam tutoring services",
    "hesi exit exam support",
    "nursing school test prep",
    "hesi admission assessment help",
    "healthcare entrance exam guide",
    "hesi practice test resources",
    "nursing certification exam prep",
    "hesi exam study materials",
    "professional nursing test help",
    "hesi exam tutoring online",
    "nursing exam preparation course",
    "hesi test taking strategies",
    "medical school entrance prep",
    "hesi comprehensive review",
    "nursing student exam support",
    "hesi exam coaching services",
    "healthcare test preparation",
    "hesi specialty exams help",
    "nursing program admission test",
    "hesi exam score improvement",
    "medical entrance test coaching",
    "hesi critical thinking prep"
]

# Pre-defined natural anchor texts
ANCHORS = [
    "Expert HESI Guidance",
    "Professional Test Help",
    "Get Started Today",
    "Learn More About Our Services",
    "Access Study Resources",
    "Contact Our Specialists",
    "View Success Stories",
    "Explore Exam Strategies",
    "Schedule Consultation",
    "Download Study Guide",
    "Join Our Program",
    "Request Information",
    "Book Your Session",
    "See Pricing Options",
    "Read Student Reviews",
    "Start Free Trial",
    "Browse Course Catalog",
    "Meet Our Tutors",
    "Check Availability",
    "Enroll Now"
]

# Sentence starters
STARTERS = [
    "Get", "Access", "Discover", "Learn", "Find", "Explore",
    "Achieve", "Master", "Unlock", "Boost", "Improve", "Enhance"
]

class SimpleContentGen:
    def __init__(self):
        self.keywords = KEYWORDS
        self.anchors = ANCHORS
        self.starters = STARTERS
        self.domain = domain
    
    def make_slug(self, text):
        slug = text.lower().replace(" ", "-")
        slug = re.sub(r"[^a-z0-9-]", "", slug)
        return slug[:40]
    
    def generate_content(self):
        kw = random.choice(self.keywords)
        starter = random.choice(self.starters)
        anchor1 = random.choice(self.anchors)
        anchor2 = random.choice([a for a in self.anchors if a != anchor1])
        
        slug1 = self.make_slug(kw)
        slug2 = self.make_slug(random.choice(self.keywords))
        
        # Multiple template variations
        templates = [
            f"{starter} expert {kw} from qualified professionals. Our comprehensive <a href='https://{self.domain}/{slug1}'>{anchor1}</a> services ensure success. Personalized <a href='https://{self.domain}/{slug2}'>{anchor2}</a> support available 24/7.",
            
            f"Need {kw}? Professional specialists provide <a href='https://{self.domain}/{slug1}'>{anchor1}</a> with proven results. Get comprehensive <a href='https://{self.domain}/{slug2}'>{anchor2}</a> and achieve your goals.",
            
            f"{starter} better results with {kw} solutions. Expert <a href='https://{self.domain}/{slug1}'>{anchor1}</a> ensures optimal performance. <a href='https://{self.domain}/{slug2}'>{anchor2}</a> for personalized assistance.",
            
            f"Professional {kw} tailored to your needs. <a href='https://{self.domain}/{slug1}'>{anchor1}</a> from experienced tutors. Comprehensive <a href='https://{self.domain}/{slug2}'>{anchor2}</a> programs available.",
            
            f"{starter} specialized {kw} for nursing students. Our <a href='https://{self.domain}/{slug1}'>{anchor1}</a> team delivers results. <a href='https://{self.domain}/{slug2}'>{anchor2}</a> to start your journey.",
            
            f"Excel in your exams with {kw}. Professional <a href='https://{self.domain}/{slug1}'>{anchor1}</a> provides comprehensive support. <a href='https://{self.domain}/{slug2}'>{anchor2}</a> for expert assistance."
        ]
        
        content = random.choice(templates)
        
        # Ensure proper word count
        words = content.split()
        if len(words) > 50:
            content = " ".join(words[:48]) + "."
        elif len(words) < 30:
            content += f" Contact us for more information."
        
        return {
            "keyword": kw,
            "content": content,
            "word_count": len(content.split()),
            "links_count": content.count("<a href"),
            "anchor_texts": [anchor1, anchor2]
        }

# Generate 175 content pieces
print("")
print("Generating 175 SEO content pieces...")
print("")

generator = SimpleContentGen()
all_content = []

for i in range(1, 176):
    piece = generator.generate_content()
    piece["id"] = i
    all_content.append(piece)
    
    if i % 25 == 0:
        print(f"Generated: {i}/175")

# Save to file
output_file = "seo_expert_content.json"
with open(output_file, "w") as f:
    json.dump(all_content, f, indent=2)

print("")
print("=" * 70)
print("GENERATION COMPLETE!")
print("=" * 70)
print(f"Output file: {output_file}")
print(f"Total pieces: {len(all_content)}")
print(f"Average words: {sum(p['word_count'] for p in all_content) / len(all_content):.1f}")
print(f"Total links: {sum(p['links_count'] for p in all_content)}")
print(f"Unique keywords: {len(set(p['keyword'] for p in all_content))}")
print("")
print("Sample content:")
print(f"ID: {all_content[0]['id']}")
print(f"Keyword: {all_content[0]['keyword']}")
print(f"Content: {all_content[0]['content']}")
print("")
print("File saved successfully!")
PYTHON_END

                    python3 generate_all.py
                    
                    # Verify file exists
                    if [ -f "seo_expert_content.json" ]; then
                        echo ""
                        echo "SUCCESS! File created:"
                        ls -lh seo_expert_content.json
                        echo ""
                        echo "File content preview:"
                        head -20 seo_expert_content.json
                    else
                        echo "ERROR: File not created!"
                        exit 1
                    fi
                    '''
                }
            }
        }

        stage('Push to GitHub') {
            steps {
                dir('content-generation') {
                    sh '''
                    git config user.email "ayzazkhan82@gmail.com"
                    git config user.name "Ayzazkhan"
                    
                    # Add files
                    git add seo_expert_content.json generate_all.py
                    
                    # Commit
                    git commit -m "SEO Content: 175 pieces [Build ${BUILD_NUMBER}]" || echo "No changes"
                    
                    # Push
                    git push origin main || echo "Push completed"
                    
                    echo ""
                    echo "Files pushed to GitHub!"
                    '''
                }
            }
        }
    }

    post {
        always {
            dir('content-generation') {
                sh '''
                echo ""
                echo "Final files in directory:"
                ls -la *.json *.py 2>/dev/null || echo "No files found"
                echo ""
                '''
            }
        }
        success {
            echo "SUCCESS! Check: content-generation/seo_expert_content.json"
        }
        failure {
            echo "FAILED! Check console output for errors"
        }
    }
}
