print("\\n" + "=" * 70)
print("📊 GENERATION COMPLETED - NEW MODELS EDITION")
print("=" * 70)
print(f"🎯 Target Content: {TOTAL_CONTENTS}")
print(f"✅ Successfully Generated: {success_count} ({success_count/TOTAL_CONTENTS*100:.1f}%)")
print(f"🤖 Model Success: {model_success_count}")
print(f"🔄 Fallback Used: {fallback_count}")
print(f"🔗 Total Links: {sum(item['links_count'] for item in generated_data)}")
print(f"📝 Total Words: {sum(item['word_count'] for item in generated_data)}")

if available_models and available_models[0] != "fallback":
    print(f"🔧 Models Used: {', '.join(set(item['model_used'] for item in generated_data))}")

print(f"\\n📈 QUALITY METRICS:")
avg_words = sum(item['word_count'] for item in generated_data) / len(generated_data)
avg_links = sum(item['links_count'] for item in generated_data) / len(generated_data)
print(f"   Average Words: {avg_words:.1f}")
print(f"   Average Links: {avg_links:.1f}")
print(f"   Unique Keywords: {len(set(item['keyword'] for item in generated_data))}")

print("\\n🚀 CONTENT GENERATION WITH NEW MODELS COMPLETED!")
EOF

                    # Run the content generator
                    python3 content_generator.py
                    '''
                }
            }
        }

        stage('Verify & Push Results') {
            steps {
                dir('content-generation') {
                    sh '''
                    echo "🔍 VERIFYING GENERATED CONTENT..."
                    . venv/bin/activate
                    
                    # Verification script
                    python3 - << 'EOF'
import json, os
from collections import Counter

print("📊 NEW MODELS CONTENT VERIFICATION")
print("=" * 50)

file_path = "new_models_content.json"
if not os.path.exists(file_path):
    print("❌ Generated file not found!")
    exit(1)

try:
    with open(file_path, "r", encoding="utf-8") as f:
        data = json.load(f)
    
    print(f"✅ File loaded: {len(data)} content pieces")
    
    # Analysis
    model_usage = Counter([item.get('model_used', 'unknown') for item in data])
    keyword_usage = Counter([item['keyword'] for item in data])
    
    print(f"\\n🔧 MODEL USAGE:")
    for model, count in model_usage.most_common():
        print(f"   {model}: {count} times ({count/len(data)*100:.1f}%)")
    
    print(f"\\n🎯 KEYWORD DISTRIBUTION:")
    for keyword, count in keyword_usage.most_common(5):
        print(f"   {keyword}: {count} times")
    
    # Quality checks
    quality_issues = []
    for item in data:
        if item.get('links_count', 0) != 2:
            quality_issues.append(f"Item {item['id']}: {item.get('links_count', 0)} links")
        if item.get('word_count', 0) < 35:
            quality_issues.append(f"Item {item['id']}: {item.get('word_count', 0)} words")
    
    print(f"\\n📈 QUALITY REPORT:")
    print(f"   - Total Items: {len(data)}")
    print(f"   - Quality Issues: {len(quality_issues)}")
    print(f"   - Avg Links: {sum(item.get('links_count', 0) for item in data)/len(data):.1f}")
    print(f"   - Avg Words: {sum(item.get('word_count', 0) for item in data)/len(data):.1f}")
    
    if quality_issues:
        print(f"\\n⚠️  Issues (sample):")
        for issue in quality_issues[:3]:
            print(f"   - {issue}")
    
    # Show samples
    print(f"\\n📝 CONTENT SAMPLES:")
    for i, item in enumerate(data[:2]):
        print(f"\\n{i+1}. [{item.get('model_used', 'unknown')}] {item['keyword']}")
        print(f"   Links: {item.get('links_count', 0)}")
        print(f"   Words: {item.get('word_count', 0)}")
        print(f"   Preview: {item['content'][:80]}...")
        print("-" * 40)
    
    print(f"\\n🎉 VERIFICATION COMPLETED SUCCESSFULLY!")
    
except Exception as e:
    print(f"❌ Verification failed: {e}")
    exit(1)
EOF

                    # Push to GitHub
                    echo "🚀 Pushing to GitHub..."
