pipeline {
    agent any

    environment {
        HUGGINGFACE_API_KEY = credentials('hugging-face')  // ✅ Changed credential ID
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Ayzazkhan/Godady-digilaxy-partner-page-automation.git',
                    credentialsId: 'github-credentials'
            }
        }

        stage('Setup Python Environment') {
            steps {
                dir('content-generation') {
                    sh '''
                    echo "🐍 Setting up Python environment..."
                    python3 --version
                    pip3 --version
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install requests
                    echo "✅ Python packages installed:"
                    pip list | grep requests
                    '''
                }
            }
        }

        stage('Validate Environment') {
            steps {
                dir('content-generation') {
                    sh '''
                    echo "🔍 Environment Validation..."
                    . venv/bin/activate
                    echo "📁 Current directory: $(pwd)"
                    echo "📁 Files in directory:"
                    ls -la
                    echo "🔑 Checking API key availability..."
                    if [ -n "$HUGGINGFACE_API_KEY" ]; then
                        echo "✅ HUGGINGFACE_API_KEY is available (length: ${#HUGGINGFACE_API_KEY})"
                    else
                        echo "❌ HUGGINGFACE_API_KEY is empty!"
                        exit 1
                    fi
                    echo "📄 Checking content.json..."
                    if [ -f "content.json" ]; then
                        echo "✅ content.json exists"
                        python3 -c "import json; data=json.load(open('content.json')); print('📋 Base content length:', len(data.get('base_content', ''))); print('🎯 Keywords:', len(data.get('keywords', [])))"
                    else
                        echo "❌ content.json missing!"
                        exit 1
                    fi
                    '''
                }
            }
        }

        stage('Generate Content') {
            steps {
                dir('content-generation') {
                    sh '''
                    echo "🚀 Starting Content Generation with Hugging Face..."
                    . venv/bin/activate
                    
                    # Create debug script for Hugging Face
                    cat > debug_generator.py << 'EOF'
import json
import os
import requests
import random
import time
import re
import sys

print("🚀 Starting SEO content generator (Hugging Face Debug Version)...")
print(f"📁 Current directory: {os.getcwd()}")
print(f"🔑 Hugging Face API Key available: {'Yes' if os.environ.get('HUGGINGFACE_API_KEY') else 'No'}")

# Load content.json
try:
    with open("content.json", "r") as f:
        config = json.load(f)
    print("✅ content.json loaded successfully")
except Exception as e:
    print(f"❌ ERROR reading content.json: {e}")
    sys.exit(1)

base_content = config.get("base_content")
domain = config.get("target_domain")
keywords = config.get("keywords", [])
tone = config.get("tone", "professional and educational")

print(f"📊 Config Summary:")
print(f"  - Domain: {domain}")
print(f"  - Keywords count: {len(keywords)}")
print(f"  - Base content length: {len(base_content) if base_content else 0}")

if not base_content or not domain:
    print("❌ ERROR: base_content or domain missing in content.json")
    sys.exit(1)

# Hugging Face API Configuration
HUGGINGFACE_API_KEY = os.environ.get("HUGGINGFACE_API_KEY")
if not HUGGINGFACE_API_KEY:
    print("❌ ERROR: HUGGINGFACE_API_KEY not found!")
    sys.exit(1)

print(f"🔑 Hugging Face API Key length: {len(HUGGINGFACE_API_KEY)}")

# Extract links
links = re.findall(r"<a href='https://[^']+'[^>]*>[^<]+</a>", base_content)
print(f"🔗 Found {len(links)} links in base content")

if len(links) == 0:
    print("❌ ERROR: No links found inside base_content!")
    sys.exit(1)

# Hugging Face Content Generator
def generate_single_content(keyword):
    print(f"  🤖 Generating for: {keyword}")
    
    prompt = f"""
Write a short promotional SEO paragraph (35-45 words) about {keyword} for nursing students.
Include these links naturally: {chr(10).join(links)}
Tone: {tone}
Make it sound human and professional.
"""

    try:
        headers = {
            "Authorization": f"Bearer {HUGGINGFACE_API_KEY}",
            "Content-Type": "application/json"
        }
        
        # Using Microsoft DialoGPT model (free and reliable)
        API_URL = "https://api-inference.huggingface.co/models/microsoft/DialoGPT-large"
        
        payload = {
            "inputs": prompt,
            "parameters": {
                "max_length": 200,
                "temperature": 0.8,
                "do_sample": True,
                "return_full_text": False
            },
            "options": {
                "wait_for_model": True
            }
        }
        
        print(f"  📡 Calling Hugging Face API...")
        response = requests.post(
            API_URL,
            headers=headers,
            json=payload,
            timeout=60
        )
        
        print(f"  📊 API Response Status: {response.status_code}")
        
        if response.status_code == 200:
            result = response.json()
            if isinstance(result, list) and len(result) > 0:
                content = result[0].get('generated_text', '').strip()
                print(f"  ✅ Generated content length: {len(content)}")
                return content
            else:
                print(f"  ❌ Unexpected response format: {result}")
        else:
            print(f"  ❌ API Error {response.status_code}: {response.text}")
            
    except Exception as e:
        print(f"  ❌ API Call Failed: {str(e)}")
    
    # Fallback content
    fallback = f"Get expert {keyword} assistance with comprehensive nursing exam preparation and professional guidance. {links[0] if len(links) > 0 else ''} {links[1] if len(links) > 1 else ''}"
    print(f"  🔄 Using fallback content")
    return fallback

# Main Loop
TOTAL = 10  # Reduced for testing
generated_data = []

print(f"🎯 Generating {TOTAL} SEO contents with Hugging Face...")

for i in range(TOTAL):
    try:
        keyword = random.choice(keywords)
        print(f"📝 {i+1}/{TOTAL} Processing...")

        content = generate_single_content(keyword)

        # Ensure all required links are included
        links_included = 0
        for link in links:
            if link in content:
                links_included += 1
            else:
                content += f" {link}"

        generated_data.append({
            "id": i + 1,
            "keyword": keyword,
            "content": content,
            "word_count": len(content.split()),
            "links_included": links_included
        })

        print(f"✅ Completed item {i+1}/{TOTAL} - Links: {links_included}")
        time.sleep(2)  # Rate limiting

    except Exception as e:
        print(f"❌ Error in item {i+1}: {str(e)}")
        continue

# Save Output
print("💾 Saving to output.json...")
try:
    with open("output.json", "w", encoding="utf-8") as f:
        json.dump(generated_data, f, indent=2, ensure_ascii=False)

    print(f"🎉 SUCCESS! {len(generated_data)} contents saved in output.json")
    print(f"📊 Final stats:")
    print(f"  - Total items: {len(generated_data)}")
    print(f"  - Total words: {sum(item['word_count'] for item in generated_data)}")
    print(f"  - Average links: {sum(item['links_included'] for item in generated_data) / len(generated_data):.1f}")

except Exception as e:
    print(f"❌ Error saving file: {e}")
    sys.exit(1)
EOF

                    # Run the debug script
                    python3 debug_generator.py
                    '''
                }
            }
        }

        // ... Rest of the stages remain same (Verify Output, Push to GitHub)
    }

    post {
        always {
            dir('content-generation') {
                sh '''
                echo "🧹 Cleaning up..."
                rm -rf venv
                echo "📁 Final files:"
                ls -la
                '''
            }
            archiveArtifacts artifacts: 'content-generation/output.json', fingerprint: true
        }
        success {
            echo "🎉 Pipeline executed successfully with Hugging Face!"
        }
        failure {
            echo "❌ Pipeline failed - check logs above for details"
        }
    }
}
