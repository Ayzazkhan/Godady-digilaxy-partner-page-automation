pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  stages {

    /* =========================
       CHECKOUT REPOSITORY
       ========================= */
    stage('Checkout') {
      steps {
        git branch: 'main',
            url: 'https://github.com/Ayzazkhan/Godady-digilaxy-partner-page-automation.git',
            credentialsId: 'github-access'
      }
    }

    /* =========================
       CANONICAL UPDATE (PARTNERS-1)
       ========================= */
   stage('Canonical Update (partners-1)') {
  steps {
    script {

      def domains = sh(
        script: """
        python3 - <<'PY'
import json
print("\\n".join(json.load(open('partners-1-init/data/domains.json')).keys()))
PY
        """,
        returnStdout: true
      ).trim().split("\\n")

      def success = []
      def failed  = []

      for (domain in domains) {

        def credentialId = "partners-${domain}"
        def ftpUsername  = "partners@${domain}"   // ✅ IMPORTANT FIX

        echo "🔐 Using credential: ${credentialId}"
        echo "👤 FTP Username: ${ftpUsername}"

        try {
          withCredentials([
            usernamePassword(
              credentialsId: credentialId,
              usernameVariable: 'FTP_PASS_USERNAME',
              passwordVariable: 'FTP_PASS'
            )
          ]) {
            sh """
              export CURRENT_DOMAIN=${domain}
              export FTP_USER=${ftpUsername}
              export FTP_PASS=\$FTP_PASS
              python3 partners-1-init/scripts/ftp_canonical_update.py
            """
          }

          success.add(domain)

        } catch (err) {
          echo "❌ FAILED: ${domain} | ${err.getMessage()}"
          failed.add(domain)
        }
      }

      echo "========== FINAL SUMMARY =========="
      echo "✅ SUCCESS (${success.size()})"
      success.each { echo "  ✔ ${it}" }

      echo "❌ FAILED (${failed.size()})"
      failed.each { echo "  ✖ ${it}" }
      echo "================================="
    }
  }
}
