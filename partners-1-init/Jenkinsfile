stage('Canonical Update (partners-1)') {
  steps {
    script {
      def domains = sh(
        script: """
        python3 - <<'PY'
import json
print('\\n'.join(json.load(open('partners-1-init/data/domains.json')).keys()))
PY
        """,
        returnStdout: true
      ).trim().split("\\n")

      for (d in domains) {
        def credId = "partners-${d}"
        echo "🔐 Trying credential: ${credId}"

        try {
          withCredentials([
            usernamePassword(
              credentialsId: credId,
              usernameVariable: 'FTP_USER',
              passwordVariable: 'FTP_PASS'
            )
          ]) {
            sh """
              export CURRENT_DOMAIN=${d}
              export FTP_USER=\$FTP_USER
              export FTP_PASS=\$FTP_PASS
              python3 partners-1-init/scripts/ftp_canonical_update.py
            """
          }
        } catch (err) {
          echo "⚠️ Skipped ${d} — FTP credential missing or login failed"
        }
      }
    }
  }
}
