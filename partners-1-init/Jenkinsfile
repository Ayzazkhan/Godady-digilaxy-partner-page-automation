pipeline {
  agent any

  stages {
    stage('Checkout') {
      steps {
        git credentialsId: 'github-access',
            url: 'https://github.com/Ayzazkhan/Godady-digilaxy-partner-page-automation.git',
            branch: 'main'
      }
    }

    stage('Canonical Update (partners-1)') {
      steps {
        script {
          def domains = sh(
            script: "python3 - <<'PY'\nimport json\nprint('\\n'.join(json.load(open('partners-1-init/data/domains.json')).keys()))\nPY",
            returnStdout: true
          ).trim().split("\n")

          echo "Domains found: ${domains}"

          for (d in domains) {
            def credId = "partners-${d}"
            echo "🔐 Using credential: ${credId}"

            withCredentials([
              usernamePassword(
                credentialsId: credId,
                usernameVariable: 'FTP_USER',
                passwordVariable: 'FTP_PASS'
              )
            ]) {
              sh """
                export FTP_USER=\$FTP_USER
                export FTP_PASS=\$FTP_PASS
                python3 partners-1-init/scripts/ftp_canonical_update.py
              """
            }
          }
        }
      }
    }
  }

  post {
    success { echo "✅ Canonical automation completed" }
    failure { echo "⚠️ Pipeline finished with issues — check logs" }
  }
}
