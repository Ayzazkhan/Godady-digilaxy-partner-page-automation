pipeline {
  agent any
  
  options {
    timestamps()
    disableConcurrentBuilds()
  }
  
  stages {
    /* ==========================================
       CHECKOUT REPOSITORY
       ========================================== */
    stage('Checkout') {
      steps {
        git branch: 'main',
            url: 'https://github.com/Ayzazkhan/Godady-digilaxy-partner-page-automation.git',
            credentialsId: 'github-access'
      }
    }
    
    /* ==========================================
       FTP LOGIN TEST:
       1. Load domains.json with host info
       2. Get credentials (username: partners@domain)
       3. Test FTP login
       4. Separate success/fail lists
       5. Show final report
       ========================================== */
    stage('FTP Login Test') {
      steps {
        script {
          // Load domains.json with host info
          def domainsData = sh(
            script: """
              python3 - <<'PY'
import json
data = json.load(open('partners-1-QA/data/domains.json'))
for domain, info in data.items():
    print(f"{domain}|{info['host']}")
PY
            """,
            returnStdout: true
          ).trim().split("\\n")
          
          def successList = []
          def failedList = []
          
          echo "📊 Total domains to test: ${domainsData.size()}"
          echo ""
          
          // Test each domain
          for (line in domainsData) {
            def parts = line.split("\\|")
            def domain = parts[0]
            def host = parts[1]
            def credentialId = "partners-${domain}"
            def ftpUsername = "partners@${domain}"
            
            echo "${'='*60}"
            echo "🔐 Credential: ${credentialId}"
            echo "👤 FTP User: ${ftpUsername}"
            echo "🌐 FTP Host: ${host}"
            echo "📌 Domain: ${domain}"
            echo "${'='*60}"
            
            try {
              withCredentials([
                usernamePassword(
                  credentialsId: credentialId,
                  usernameVariable: 'FTP_PASS_USERNAME',
                  passwordVariable: 'FTP_PASS'
                )
              ]) {
                sh """
                  export CURRENT_DOMAIN='${domain}'
                  export FTP_HOST='${host}'
                  export FTP_USER='${ftpUsername}'
                  export FTP_PASS=\$FTP_PASS
                  python3 partners-1-QA/scripts/qa_check.py
                """
              }
              successList.add(domain)
            } catch (err) {
              failedList.add(domain)
            }
          }
          
          // Final Report
          echo "\n\n"
          echo "${'='*70}"
          echo "                  FTP LOGIN TEST REPORT"
          echo "${'='*70}"
          echo ""
          echo "✅ SUCCESSFUL LOGINS: ${successList.size()} domains"
          echo "${'='*70}"
          successList.each { echo "   ✔ ${it}" }
          echo ""
          echo ""
          echo "❌ FAILED LOGINS: ${failedList.size()} domains"
          echo "${'='*70}"
          failedList.each { echo "   ✖ ${it}" }
          echo ""
          echo "${'='*70}"
          echo "Total Tested: ${domainsData.size()}"
          echo "Success Rate: ${successList.size()}/${domainsData.size()} (${String.format('%.1f', (successList.size() * 100.0 / domainsData.size()))}%)"
          echo "${'='*70}"
          
          // Set build status
          if (failedList.size() > 0) {
            currentBuild.result = 'UNSTABLE'
            echo "\n⚠️ ${failedList.size()} domains have login issues"
          } else {
            echo "\n🎉 All domains have successful FTP login!"
          }
        }
      }
    }
  }
  
  post {
    success {
      echo "\n🎉 FTP login test completed - all successful"
    }
    unstable {
      echo "\n⚠️ Some domains failed login - check report above"
    }
    failure {
      echo "\n❌ Test pipeline failed - check console output"
    }
  }
}
