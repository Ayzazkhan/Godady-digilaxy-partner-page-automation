pipeline {
  agent any
  options {
    timestamps()
    disableConcurrentBuilds()
  }

  stages {

    stage('Checkout') {
      steps {
        git branch: 'main',
            url: 'https://github.com/Ayzazkhan/Godady-digilaxy-partner-page-automation.git',
            credentialsId: 'github-access'
      }
    }

    stage('FTP Login Test') {
      steps {
        script {
          def ftpHost     = "63u.9b4.mytemp.website"
          def ftpUsername = "all@63u.9b4.mytemp.website"
          def credId      = "ftp-digilaxy"

          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          echo "🔌 FTP LOGIN TEST"
          echo "   Host       : ${ftpHost}"
          echo "   Username   : ${ftpUsername}"
          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

          withCredentials([
            usernamePassword(
              credentialsId: credId,
              usernameVariable: 'FTP_USER_CRED',
              passwordVariable: 'FTP_PASS'
            )
          ]) {
            sh """
              python3 - << 'PYEOF'
import os
from ftplib import FTP

ftp_host = "${ftpHost}"
ftp_user = "${ftpUsername}"
ftp_pass = os.environ.get("FTP_PASS")

print("=" * 50)
print("FTP LOGIN TEST")
print("=" * 50)
print(f"Host : {ftp_host}")
print(f"User : {ftp_user}")
print(f"Pass : {'***' if ftp_pass else 'MISSING'}")

try:
    ftp = FTP(ftp_host, timeout=30)
    ftp.login(ftp_user, ftp_pass)
    print("\\n✅ FTP LOGIN SUCCESSFUL!")
    print(f"   Root directory : {ftp.pwd()}")
    print("\\n   Folders on server:")
    for item in ftp.nlst():
        print(f"   - {item}")
    ftp.quit()
    print("\\n✅ FTP connection closed")
except Exception as e:
    print(f"\\n❌ FTP LOGIN FAILED: {e}")
    exit(1)
PYEOF
            """
          }
        }
      }
    }
  }

  post {
    success { echo "✅ FTP Login test PASSED" }
    failure { echo "❌ FTP Login test FAILED" }
  }
}
